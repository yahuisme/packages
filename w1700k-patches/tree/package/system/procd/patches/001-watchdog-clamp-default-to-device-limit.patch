From: Vitaliy Sochnev <sochnev.v.74@gmail.com>
Subject: [PATCH] procd: limit watchdog default timeout to the device maximum

The default 30-second timeout exceeds the 28-second limit of the Airoha
AN7581 watchdog. Read watchdog0/max_timeout before the initial ioctl in
each init stage. Missing or invalid limits leave the existing timeout and
the official SETTIMEOUT/GETTIMEOUT fallback unchanged.

Based on OpenWRT-fanboy/OpenW1700k commit
3cb57ea0418daa5119853d736d4d95e63171a4ac.
Project adjustments: remember explicit requests, including those made
while stopped, so later init never clamps them. Parse the complete sysfs
decimal line with overflow checking instead of fscanf("%u"). Preserve the
default heartbeat and all explicit-request ioctl handling.
Requires CONFIG_WATCHDOG_SYSFS for the optional max_timeout attribute.

Signed-off-by: Vitaliy Sochnev <sochnev.v.74@gmail.com>

---

--- a/watchdog.c
+++ b/watchdog.c
@@ -19,6 +19,9 @@
 #include <sys/stat.h>
 #include <fcntl.h>
 
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
 #include <unistd.h>
 
 #include <libubox/uloop.h>
@@ -32,6 +35,7 @@
 static int wdt_fd = -1;
 static int wdt_drv_timeout = 30;
 static int wdt_frequency = 5;
+static bool wdt_timeout_set = false;
 static bool wdt_magicclose = false;
 
 void watchdog_ping(void)
@@ -87,8 +91,32 @@ static void watchdog_close(bool with_re
 	wdt_fd = -1;
 }
 
+static void watchdog_limit_default_timeout(void)
+{
+	char buf[32], *end;
+	unsigned long max_timeout;
+	FILE *fp;
+
+	if (wdt_timeout_set)
+		return;
+
+	/* /dev/watchdog is the legacy alias for watchdog0. */
+	fp = fopen("/sys/class/watchdog/watchdog0/max_timeout", "r");
+	if (fp) {
+		if (fgets(buf, sizeof(buf), fp) && fgetc(fp) == EOF && !ferror(fp)) {
+			errno = 0;
+			max_timeout = strtoul(buf, &end, 10);
+			if (!errno && buf[0] >= '0' && buf[0] <= '9' &&
+			    *end == '\n' && !end[1] &&
+			    max_timeout && max_timeout < wdt_drv_timeout)
+				wdt_drv_timeout = max_timeout;
+		}
+		fclose(fp);
+	}
+}
+
 static int watchdog_set_drv_timeout(void)
 {
 	if (wdt_fd < 0)
 		return -1;
 
@@ -164,6 +192,7 @@ int watchdog_timeout(int timeout)
 	if (timeout) {
 		DEBUG(4, "Set watchdog timeout: %ds\n", timeout);
 		wdt_drv_timeout = timeout;
+		wdt_timeout_set = true;
 
 		if (wdt_fd >= 0)
 			watchdog_set_drv_timeout();
@@ -202,7 +231,8 @@ void watchdog_init(int preinit)
 		return;
 
 	LOG("- watchdog -\n");
+	watchdog_limit_default_timeout();
 	watchdog_set_drv_timeout();
 	watchdog_timeout_cb(&wdt_timeout);
 
 	DEBUG(4, "Opened watchdog with timeout %ds\n", watchdog_timeout(0));
