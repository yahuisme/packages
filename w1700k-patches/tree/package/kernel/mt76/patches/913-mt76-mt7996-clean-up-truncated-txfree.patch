Subject: [PATCH] wifi: mt76: mt7996: finish cleanup after truncated txfree

Based on OpenWRT-fanboy/OpenW1700k commits
23df1d78c6476d4a301ecd56aab65f4c6be86542 (0005 txfree overrun) and
12650fa28dfedccb20d726780c06c8fa45074b18 (0005 partial TX free batches).

Keep the existing WARN_ON_ONCE diagnostic. Leave the descriptor loop on a
truncated event so the already completed prefix still reaches the existing
TX wake, worker scheduling and free_list consumption. Validate the fixed
header, complete info words and version 7 pair extension before reading;
pull fragmented TXFREE skbs into the linear area before parsing. Do not
change token ownership or reclaim tokens whose completion was not reported.

Validate the first RX word before classification in both the raw DMA
and skb entrypoints; refresh pointers after a successful header pull.

--- a/mt7996/mac.c
+++ b/mt7996/mac.c
@@ -1262,10 +1262,15 @@
 	struct mt76_wcid *wcid = NULL;
 	LIST_HEAD(free_list);
 	struct sk_buff *skb, *tmp;
-	void *end = data + len;
+	void *end;
 	bool wake = false;
 	u16 total, count = 0;
 	u8 ver;
+
+	if (len < 2 * (int)sizeof(*tx_free))
+		return;
+
+	end = data + len;
 
 	/* clean DMA queues and unmap buffers first */
 	mt76_queue_tx_cleanup(dev, dev->mphy.q_tx[MT_TXQ_PSD], false);
@@ -1288,8 +1293,9 @@
 		u32 msdu, info;
 		u8 i;
 
-		if (WARN_ON_ONCE((void *)cur_info >= end))
-			return;
+		if (WARN_ON_ONCE((void *)cur_info >= end ||
+				 end - (void *)cur_info < sizeof(*cur_info)))
+			break;
 		/* 1'b1: new wcid pair.
 		 * 1'b0: msdu_id with the same 'wcid pair' as above.
 		 */
@@ -1312,6 +1318,7 @@
 next:
 			/* ver 7 has a new DW with pair = 1, skip it */
-			if (ver == 7 && ((void *)(cur_info + 1) < end) &&
+			if (ver == 7 &&
+			    end - (void *)(cur_info + 1) >= sizeof(*cur_info) &&
 			    (le32_to_cpu(*(cur_info + 1)) & MT_TXFREE_INFO_PAIR))
 				cur_info++;
 			continue;
@@ -1538,9 +1545,13 @@
 {
 	struct mt7996_dev *dev = container_of(mdev, struct mt7996_dev, mt76);
 	__le32 *rxd = (__le32 *)data;
-	__le32 *end = (__le32 *)&rxd[len / 4];
+	__le32 *end;
 	enum rx_pkt_type type;
 
+	if (len < (int)sizeof(*rxd))
+		return false;
+
+	end = (__le32 *)&rxd[len / 4];
 	type = le32_get_bits(rxd[0], MT_RXD0_PKT_TYPE);
 	if (type != PKT_TYPE_NORMAL) {
 		u32 sw_type = le32_get_bits(rxd[0], MT_RXD0_SW_PKT_TYPE_MASK);
@@ -1570,10 +1581,16 @@
 			 struct sk_buff *skb, u32 *info)
 {
 	struct mt7996_dev *dev = container_of(mdev, struct mt7996_dev, mt76);
-	__le32 *rxd = (__le32 *)skb->data;
-	__le32 *end = (__le32 *)&skb->data[skb->len];
+	__le32 *rxd, *end;
 	enum rx_pkt_type type;
 
+	if (!pskb_may_pull(skb, sizeof(*rxd))) {
+		dev_kfree_skb(skb);
+		return;
+	}
+
+	rxd = (__le32 *)skb->data;
+	end = (__le32 *)&skb->data[skb->len];
 	type = le32_get_bits(rxd[0], MT_RXD0_PKT_TYPE);
 	if (type != PKT_TYPE_NORMAL) {
 		u32 sw_type = le32_get_bits(rxd[0], MT_RXD0_SW_PKT_TYPE_MASK);
@@ -1591,7 +1608,8 @@
 			break;
 		}
 
-		mt7996_mac_tx_free(dev, skb->data, skb->len);
+		if (pskb_may_pull(skb, skb->len))
+			mt7996_mac_tx_free(dev, skb->data, skb->len);
 		napi_consume_skb(skb, 1);
 		break;
 	case PKT_TYPE_RX_EVENT:
