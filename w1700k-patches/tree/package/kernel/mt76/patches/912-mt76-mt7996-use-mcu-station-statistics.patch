+int mt7996_mcu_get_per_sta_info(struct mt7996_phy *phy, u16 tag)
+{
+	struct mt7996_dev *dev = phy->dev;
+	struct mt7996_mcu_per_sta_info_event *res;
+	struct mt76_wcid *wcid;
+	struct sk_buff *skb;
+	DECLARE_BITMAP(seen, PER_STA_INFO_MAX_NUM);
+	int i, j, ret, sta_num, resp_sta_num;
+	u16 tag_len, payload_len;
+	int wcid_idx = 0;
+	struct {
+		u8 _rsv1;
+		u8 unsolicit;
+		u8 _rsv2[2];
+
+		__le16 tag;
+		__le16 len;
+		__le16 sta_num;
+		u8 _rsv3[2];
+		__le16 wlan_idx[PER_STA_INFO_MAX_NUM];
+	} __packed req = {
+		.tag = cpu_to_le16(tag),
+		.len = cpu_to_le16(sizeof(req) - 4),
+	};
+
+	if (tag != UNI_PER_STA_RSSI)
+		return -EINVAL;
+
+	while (wcid_idx < min_t(int, mt7996_wtbl_size(dev),
+				  ARRAY_SIZE(dev->mt76.wcid))) {
+		sta_num = 0;
+
+		rcu_read_lock();
+		for (i = wcid_idx;
+		     i < min_t(int, mt7996_wtbl_size(dev),
+			       ARRAY_SIZE(dev->mt76.wcid)) &&
+		     sta_num < PER_STA_INFO_MAX_NUM;
+		     i++) {
+			wcid = rcu_dereference(dev->mt76.wcid[i]);
+			if (!wcid || !wcid->sta)
+				continue;
+			req.wlan_idx[sta_num++] = cpu_to_le16(i);
+		}
+		rcu_read_unlock();
+		wcid_idx = i;
+
+		if (!sta_num)
+			continue;
+
+		req.sta_num = cpu_to_le16(sta_num);
+
+		ret = mt76_mcu_send_and_get_msg(&dev->mt76,
+						MCU_WM_UNI_CMD(PER_STA_INFO),
+						&req, sizeof(req), true, &skb);
+		if (ret)
+			return ret;
+
+		res = (struct mt7996_mcu_per_sta_info_event *)skb->data;
+
+		ret = -EINVAL;
+		if (skb->len < sizeof(*res))
+			goto out;
+
+		tag_len = le16_to_cpu(res->len);
+		if (le16_to_cpu(res->tag) != tag ||
+		    tag_len < sizeof(*res) - 4 || tag_len > skb->len - 4)
+			goto out;
+
+		/* PER_STA has no count field: derive it from the RSSI TLV. */
+		payload_len = tag_len - (sizeof(*res) - 4);
+		resp_sta_num = payload_len / sizeof(res->rssi[0]);
+		if (payload_len % sizeof(res->rssi[0]) || resp_sta_num > sta_num)
+			goto out;
+
+		bitmap_zero(seen, PER_STA_INFO_MAX_NUM);
+		for (i = 0; i < resp_sta_num; i++) {
+			u16 wlan_idx = le16_to_cpu(res->rssi[i].wlan_idx);
+
+			if (wlan_idx >= mt7996_wtbl_size(dev) ||
+			    wlan_idx >= ARRAY_SIZE(dev->mt76.wcid))
+				goto out;
+			for (j = 0; j < sta_num; j++)
+				if (res->rssi[i].wlan_idx == req.wlan_idx[j])
+					break;
+			if (j == sta_num || test_and_set_bit(j, seen))
+				goto out;
+		}
+
+		rcu_read_lock();
+		for (i = 0; i < resp_sta_num; i++) {
+			struct mt7996_sta_link *msta_link;
+			struct mt76_vif_data *mvif;
+			struct mt76_vif_link *mlink;
+			struct mt76_phy *mphy;
+			u16 wlan_idx = le16_to_cpu(res->rssi[i].wlan_idx);
+			u8 chain_mask;
+			s8 rssi[4];
+			int signal;
+
+			wcid = mt76_wcid_ptr(dev, wlan_idx);
+			if (!wcid || !wcid->sta ||
+			    wcid->link_id >= IEEE80211_MLD_MAX_NUM_LINKS)
+				continue;
+
+			msta_link = container_of(wcid, struct mt7996_sta_link, wcid);
+			mvif = &msta_link->sta->vif->mt76;
+			mlink = rcu_dereference(mvif->link[wcid->link_id]);
+			if (!mlink)
+				continue;
+			mphy = mt76_vif_link_phy(mlink);
+			if (!mphy)
+				continue;
+
+			chain_mask = mphy->antenna_mask & GENMASK(3, 0);
+			for (j = 0; j < ARRAY_SIZE(rssi); j++) {
+				/* RCPI 221..254 is reserved, 255 unavailable. */
+				if (res->rssi[i].rcpi[j] > 220) {
+					chain_mask &= ~BIT(j);
+					rssi[j] = -128;
+				} else {
+					rssi[j] = (res->rssi[i].rcpi[j] - 220) / 2;
+				}
+			}
+			if (!chain_mask)
+				continue;
+
+			signal = mt76_rx_signal(chain_mask, rssi);
+			if (signal > 0 || signal <= -128)
+				continue;
+
+			msta_link->ack_signal = signal;
