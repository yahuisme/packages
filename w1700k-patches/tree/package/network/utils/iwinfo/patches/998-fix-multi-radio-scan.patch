From: RyanZ <40222380+yahuisme@users.noreply.github.com>
Subject: [PATCH] iwinfo: keep shared-wiphy queries on the requested radio

Extend the official 100-multi_radio patch using the UCI radio index and
NL80211_ATTR_VIF_RADIO_MASK. Do not resolve a disabled radio to another
radio or a multi-radio MLO interface. Let the existing temporary-STA scan
path create an interface restricted to the requested radio instead.

Based on the upstream multi-radio ABI introduced by Felix Fietkau.
---
--- a/iwinfo_nl80211.c
+++ b/iwinfo_nl80211.c
@@ -40,7 +40,10 @@
 struct nl80211_if_data {
 	int mode;
 	int radio_idx;
+	uint32_t radio_mask;
 };
+
+static int nl80211_get_if_data(const char *ifname, struct nl80211_if_data *data);
 
 static void nl80211_close(void)
 {
@@ -432,6 +435,44 @@
 out:
 	iwinfo_uci_free();
 	return idx;
+}
+
+/* A UCI radio index is independent of both its section suffix and phy index. */
+static int nl80211_radio_mask_from_uci(const char *name, uint32_t *mask)
+{
+	struct uci_section *s;
+	struct uci_option *opt;
+	const char *value;
+	char *end;
+	unsigned long idx;
+	int ret = 0;
+
+	*mask = 0;
+	s = iwinfo_uci_get_radio(name, "mac80211");
+	if (!s)
+		goto out;
+
+	opt = uci_lookup_option(uci_ctx, s, "radio");
+	if (!opt)
+		goto out;
+
+	ret = -1;
+	if (opt->type != UCI_TYPE_STRING)
+		goto out;
+
+	value = opt->v.string;
+	if (*value < '0' || *value > '9')
+		goto out;
+
+	idx = strtoul(value, &end, 10);
+	if (end != value && !*end && idx < 32) {
+		*mask = 1U << idx;
+		ret = 0;
+	}
+
+out:
+	iwinfo_uci_free();
+	return ret;
 }
 
 static bool nl80211_is_ifname(const char *name)
@@ -814,6 +855,8 @@
 static char * nl80211_phy2ifname(const char *ifname)
 {
 	int ifidx = -1, cifidx, lmode = 1, clmode, phyidx;
+	uint32_t radio_mask;
+	struct nl80211_if_data data;
 	char buffer[512];
 	static char nif[IFNAMSIZ] = { 0 };
 	DIR *d;
@@ -829,6 +872,8 @@
 	if (phyidx < 0)
 		return NULL;
 
+	if (nl80211_radio_mask_from_uci(ifname, &radio_mask))
+		return NULL;
 	memset(nif, 0, sizeof(nif));
 
 	if ((d = opendir("/sys/class/net")) != NULL)
@@ -838,6 +883,12 @@
 			snprintf(buffer, sizeof(buffer),
 			         "/sys/class/net/%s/phy80211/index", e->d_name);
 			if (nl80211_readint(buffer) != phyidx)
+				continue;
+
+			/* Do not borrow another radio or an unrestricted MLO netdev. */
+			if (radio_mask &&
+			    (nl80211_get_if_data(e->d_name, &data) ||
+			     data.radio_mask != radio_mask))
 				continue;
 
 			snprintf(buffer, sizeof(buffer),
@@ -889,6 +940,7 @@
 	if (tb[NL80211_ATTR_VIF_RADIO_MASK]) {
 		uint32_t mask = nla_get_u32(tb[NL80211_ATTR_VIF_RADIO_MASK]);
 
+		data->radio_mask = mask;
 		for (int i = 0; mask && i < 32; i++, mask >>= 1)
 			if (mask & 1)
 				data->radio_idx = i;
@@ -906,6 +958,7 @@
 
 	data->mode = IWINFO_OPMODE_UNKNOWN;
 	data->radio_idx = -1;
+	data->radio_mask = 0;
 	nl80211_request(res ? res : ifname, NL80211_CMD_GET_INTERFACE, 0,
 	                nl80211_get_mode_cb, data);
 
@@ -1174,10 +1227,14 @@
 static char * nl80211_ifadd(const char *ifname)
 {
 	char path[PATH_MAX];
+	uint32_t radio_mask;
 	static char nif[IFNAMSIZ] = { 0 };
 	struct nl80211_msg_conveyor *req;
 	FILE *sysfs;
 
+	if (nl80211_radio_mask_from_uci(ifname, &radio_mask))
+		return NULL;
+
 	req = nl80211_msg(ifname, NL80211_CMD_NEW_INTERFACE, 0);
 	if (req)
 	{
@@ -1185,8 +1242,11 @@
 
 		NLA_PUT_STRING(req->msg, NL80211_ATTR_IFNAME, nif);
 		NLA_PUT_U32(req->msg, NL80211_ATTR_IFTYPE, NL80211_IFTYPE_STATION);
-
-		nl80211_send(req, NULL, NULL);
+		if (radio_mask)
+			NLA_PUT_U32(req->msg, NL80211_ATTR_VIF_RADIO_MASK, radio_mask);
+
+		if (nl80211_send(req, NULL, NULL))
+			return NULL;
 
 		snprintf(path, sizeof(path) - 1,
 		         "/proc/sys/net/ipv6/conf/%s/disable_ipv6", nif);
