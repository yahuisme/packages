#!/bin/sh
# One probe per interval; publish complete windows atomically in tmpfs.
. /usr/libexec/flowsense-common.sh
TARGET=${1:-223.5.5.5}
fs_target "$TARGET" || exit 2
RESULT=/tmp/npu-jitter.json
TMP="$RESULT.$$"
trap 'rm -f "$TMP"; exit 0' INT TERM
values=
while :; do
    rtt=$(ping -c 1 -W 1 "$TARGET" 2>/dev/null | awk -F' = ' '/min.*avg/ {split($2,a,"/");v=a[2];gsub(/^[[:space:]]+|[[:space:]]+$/, "", v);if (v ~ /^[0-9]+([.][0-9]+)?$/) print v}')
    values="$values ${rtt:--}"
    now=$(date +%s)
    result=$(printf '%s\n' "$values" | awk -v target="$TARGET" -v now="$now" '
    { start=NF>10?NF-9:1; n=NF-start+1; good=0; sum=0; trim=""
      for(i=start;i<=NF;i++){trim=trim (trim?" ":"") $i;if($i!="-"){sum+=$i;good++}}
      mean=good?sum/good:0;dev=0
      for(i=start;i<=NF;i++)if($i!="-")dev+=($i>mean?$i-mean:mean-$i)
      last=$NF=="-"?"null":$NF;mad=good?sprintf("%.2f",dev/good):"null"
      printf "{\"timestamp\":%d,\"target\":\"%s\",\"last_ping\":%s,\"deviation\":%s,\"samples\":%d,\"received\":%d,\"loss\":%.1f}\n%s\n",now,target,last,mad,n,good,100*(n-good)/n,trim
    }')
    printf '%s\n' "$result" | { IFS= read -r line; printf '%s\n' "$line" > "$TMP"; }
    mv -f "$TMP" "$RESULT" || exit 1
    values=${result#*
}
    sleep 5
done
