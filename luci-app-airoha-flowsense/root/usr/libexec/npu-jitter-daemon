#!/bin/sh

# NPU Jitter Daemon
# Continuously pings a target and writes jitter stats to /tmp/npu-jitter.json
# Started by /etc/init.d/npu-jitter at boot

TARGET="${1:-223.5.5.5}"
RESULT_FILE="/tmp/npu-jitter.json"
WINDOW=10
INTERVAL=5  # seconds between pings (aligned with LuCI 5s polling cycle)

ping_values=""
count=0

while true; do
	# Single ping, 1 second timeout
	rtt=$(ping -c 1 -W 1 "$TARGET" 2>/dev/null | awk -F'/' '/min.*avg/{printf "%.2f", $5}')

	if [ -n "$rtt" ]; then
		ping_values="$ping_values $rtt"
		count=$((count + 1))

		# Trim to window size and calculate mean absolute deviation (jitter) in single awk
		result=$(printf '%s' "$ping_values" | awk -v w="$WINDOW" -v t="$TARGET" '{
			start = (NF > w) ? (NF - w + 1) : 1
			n = NF - start + 1
			sum = 0
			trimmed = ""
			for (i = start; i <= NF; i++) {
				sum += $i
				trimmed = (trimmed == "") ? $i : (trimmed " " $i)
			}
			avg = sum / n
			dev = 0
			for (i = start; i <= NF; i++) dev += ($i > avg ? $i - avg : avg - $i)
			jitter = dev / n
			printf "{\"jitter\":%.2f,\"last_ping\":%.2f,\"samples\":%d,\"target\":\"%s\",\"reachable\":true,\"available\":true}\n%s", \
				jitter, $NF, n, t, trimmed
		}')

		echo "$result" | head -n 1 > "$RESULT_FILE"
		ping_values=$(echo "$result" | tail -n 1)
		count=$(echo "$ping_values" | wc -w)
	else
		# Unreachable — preserve sample count but mark unreachable
		printf '{"jitter":0,"last_ping":0,"samples":%d,"target":"%s","reachable":false,"available":true}\n' \
			"$count" "$TARGET" > "$RESULT_FILE"
	fi

	sleep "$INTERVAL"
done
