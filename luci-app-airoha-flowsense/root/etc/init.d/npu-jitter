#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
    local target enabled
    . /usr/libexec/flowsense-common.sh
    enabled=$(uci -q get npu-monitor.@jitter[0].enabled)
    [ "$enabled" != 0 ] || return 0
    target=$(uci -q get npu-monitor.@jitter[0].target)
    [ -n "$target" ] || target=223.5.5.5
    fs_target "$target" || return 1
    procd_open_instance
    procd_set_param command /usr/libexec/npu-jitter-daemon "$target"
    procd_set_param respawn 30 5 0
    procd_close_instance
}
stop_service() {
    rm -f /var/run/npu-jitter.json
}
reload_service() {
    stop
    start
}
service_triggers() {
    procd_add_reload_trigger npu-monitor
}
