#!/bin/sh
# Same collector as wifi7-status, without the per-station dump. One script owns
# ordering and framing; this name only selects the cheaper 5s telemetry mode.
[ "$#" -eq 0 ] || exit 2
case "$0" in
    /*) exec "${0%/*}/wifi7-status" summary ;;
    *) exec /usr/libexec/wifi7-status summary ;;
esac
