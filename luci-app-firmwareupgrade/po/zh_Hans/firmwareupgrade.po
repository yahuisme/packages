msgid "Firmware Upgrade"
msgstr "固件升级"

msgid "Firmware upgrade"
msgstr "固件升级"

msgid "Check a verified GitHub Release image before upgrading."
msgstr "检查已验证的 GitHub Release 固件后再升级。"

msgid "Current firmware"
msgstr "当前固件"

msgid "Latest release"
msgstr "最新版本"

msgid "Not checked"
msgstr "未检查"


msgid "Check update"
msgstr "检查更新"

msgid "Checking…"
msgstr "正在检查…"

msgid "Release details"
msgstr "版本详情"

msgid "Image"
msgstr "固件文件"

msgid "Size"
msgstr "文件大小"

msgid "SHA256"
msgstr "SHA256"

msgid "Keep settings"
msgstr "保留配置"

msgid "Upgrade firmware"
msgstr "升级固件"

msgid "Release verified. Review the image before upgrading."
msgstr "固件已验证，请核对信息后升级。"

msgid "Failed to check for updates."
msgstr "检查更新失败。"

msgid "Repository settings"
msgstr "仓库设置"

msgid "GitHub repository"
msgstr "GitHub 仓库"


msgid "GitHub access token"
msgstr "GitHub 访问令牌"

msgid "Keep settings by default"
msgstr "默认保留配置"

msgid "Save settings"
msgstr "保存设置"

msgid "Settings saved."
msgstr "设置已保存。"

msgid "Failed to save settings."
msgstr "保存设置失败。"

msgid "Confirm firmware upgrade"
msgstr "确认固件升级"

msgid "The verified image will be downloaded, checked again, and flashed."
msgstr "将下载已验证的固件，再次校验后刷写。"

msgid "Cancel"
msgstr "取消"

msgid "Start upgrade"
msgstr "开始升级"

msgid "Unable to start upgrade."
msgstr "无法开始升级。"

msgid "Upgrading firmware"
msgstr "正在升级固件"

msgid "Preparing upgrade…"
msgstr "正在准备升级…"

msgid "Grant access to firmware upgrade procedures and checks"
msgstr "允许访问固件升级流程与检查接口"

msgid "Release tag pattern"
msgstr "Release 标签通配符"

msgid "Firmware file pattern"
msgstr "固件文件通配符"

msgid "Patterns are case-sensitive: * matches any text, ? matches one character. Save before checking. Changing repository clears both rules."
msgstr "规则区分大小写：* 匹配任意文本，? 匹配单个字符。请先保存再检查；修改仓库会清空两项规则。"

msgid "GitHub download proxy"
msgstr "GitHub 下载代理"

msgid "Optional; blank connects directly. Only image downloads use this prefix; release checks connect to GitHub directly. Prefer HTTPS."
msgstr "选填，留空直连。仅镜像下载使用此前缀，检查发布仍直连 GitHub。建议使用 HTTPS。"

msgid "Save settings before checking."
msgstr "请先保存设置再检查更新。"
