msgid "Firmware Upgrade"
msgstr "固件升级"

msgid "Grant access to firmware upgrade procedures and checks"
msgstr "允许访问固件升级流程与检查接口"

msgid "Check and securely flash the latest firmware builds from GitHub Release."
msgstr "在线检测 GitHub 仓库最新构建固件，并安全校验一键刷写升级。"

msgid "Settings"
msgstr "设置"

msgid "Current Firmware"
msgstr "当前固件"

msgid "Unknown"
msgstr "未知"

msgid "Latest Available Release"
msgstr "最新可用版本"

msgid "Not Checked"
msgstr "未检测"

msgid "Click check button below to detect new version"
msgstr "点击下方按钮检查更新"

msgid "Upgrade Control"
msgstr "固件更新控制"

msgid "Check Update"
msgstr "检查更新"

msgid "Checking..."
msgstr "正在检查..."

msgid "Failed to check for updates."
msgstr "检查更新失败，请确认网络连接或仓库配置"

msgid "Release Date: "
msgstr "发布时间: "

msgid "Target Image"
msgstr "目标固件文件"

msgid "Image Size"
msgstr "固件大小"

msgid "SHA256 Checksum"
msgstr "SHA256 校验值"

msgid "Provided by sha256sums"
msgstr "提供 sha256sums 自动校对"

msgid "Upgrade Mode"
msgstr "升级模式"

msgid "Keep current settings (uncheck for clean install)"
msgstr "保留现有配置（推荐全新升级请取消勾选）"

msgid "Upgrade Firmware Now"
msgstr "立即升级固件"

msgid "Release Notes"
msgstr "更新日志"

msgid "Successfully retrieved latest release. Please verify before flashing."
msgstr "成功获取最新 Release 固件，请核对信息后升级"

msgid "Request error: "
msgstr "请求失败: "

msgid "Confirm Firmware Upgrade"
msgstr "确认固件升级"

msgid "Please verify the following upgrade parameters:"
msgstr "请确认以下刷机信息："

msgid "Device Model: "
msgstr "设备型号: "

msgid "Target Version: "
msgstr "目标版本: "

msgid "Firmware File: "
msgstr "固件文件: "

msgid "Keep Settings: "
msgstr "保留配置: "

msgid "Yes"
msgstr "是"

msgid "No (Clean Install)"
msgstr "否 (全新安装)"

msgid "Warning: Do not power off or reboot the device during flashing!"
msgstr "警告：刷机期间切勿断电或重启设备！"

msgid "Cancel"
msgstr "取消"

msgid "Confirm & Start Upgrade"
msgstr "确认并开始升级"

msgid "Failed to launch upgrade process."
msgstr "启动升级失败"

msgid "Upgrading System Firmware"
msgstr "系统固件升级中"

msgid "Initializing upgrade..."
msgstr "正在初始化升级..."

msgid "Processing securely in the background, please wait..."
msgstr "正在后台安全处理，请稍候..."

msgid "Upgrade encountered an error and was aborted."
msgstr "升级遇到错误，已中止并清理临时文件"

msgid "Firmware flashing complete. Router is rebooting..."
msgstr "固件刷写完成，路由器正在重启..."

msgid "Waiting for system to come online, remaining: "
msgstr "等待系统重新就绪，剩余时间: "

msgid "seconds"
msgstr "秒"

msgid "Repository & Network Settings"
msgstr "仓库与参数设置"

msgid "GitHub Repository"
msgstr "GitHub 仓库"

msgid "Target GitHub release repository (owner/repo)"
msgstr "目标固件 Release 仓库"

msgid "Download Mirror / Proxy"
msgstr "下载加速镜像"

msgid "Leave empty for direct GitHub connection"
msgstr "留空直接连接 GitHub"

msgid "GitHub Access Token"
msgstr "GitHub 访问令牌"

msgid "Optional, for private repositories or avoiding rate limits"
msgstr "可选，私有仓库或避免 API 限额"

msgid "Default Upgrade Mode"
msgstr "默认升级模式"

msgid "Keep settings by default (uncheck for clean install)"
msgstr "默认保留配置（不勾选则默认全新升级）"

msgid "Save Settings"
msgstr "保存配置"

msgid "Saving..."
msgstr "正在保存..."

msgid "Settings saved successfully."
msgstr "配置已成功保存"

msgid "Failed to save settings."
msgstr "保存失败，请检查系统日志"

msgid "Error saving settings: "
msgstr "保存请求异常: "
