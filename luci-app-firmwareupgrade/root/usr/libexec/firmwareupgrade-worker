#!/bin/sh
# Copyright (C) 2026 yahuisme
# Download a previously verified release image and execute sysupgrade.

umask 077

DOWNLOAD_URL="$1"
DOWNLOAD_PROXY="$7"
ASSET_NAME="$2"
EXPECTED_SHA256="$3"
KEEP_CONFIG="$4"
TOTAL_SIZE="$5"
STATUS_FILE="/var/run/firmwareupgrade.status"
PID_FILE="/var/run/firmwareupgrade.pid"
TMP_DIR=""
TARGET_FILE=""

valid_uint() {
	case "$1" in ''|*[!0-9]*|0[0-9]*|??????????*) return 1;; esac
	return 0
}

valid_sha256() {
	[ "${#1}" -eq 64 ] || return 1
	case "$1" in *[!0123456789abcdefABCDEF]*) return 1;; esac
	return 0
}

valid_asset_name() {
	case "$1" in ''|.|..|*/*|*\\*|*[!A-Za-z0-9._-]*) return 1;; esac
	return 0
}

valid_url() {
	case "$1" in https://github.com/*|https://objects.githubusercontent.com/*|https://release-assets.githubusercontent.com/*) return 0;; esac
	return 1
}

valid_download_proxy() {
	[ -z "$1" ] && return 0
	[ "${#1}" -le 200 ] || return 1
	case "$1" in http://*|https://*) ;; *) return 1;; esac
	case "$1" in *[!A-Za-z0-9.:/_-]*) return 1;; esac
	printf '%s\n' "$1" | grep -Eq '^https?://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:[0-9]{1,5})?(/[A-Za-z0-9._/-]*)?$'
}

validate_input() {
	valid_download_proxy "$DOWNLOAD_PROXY" && valid_url "$DOWNLOAD_URL" && valid_asset_name "$ASSET_NAME" && valid_sha256 "$EXPECTED_SHA256" &&
		{ [ "$KEEP_CONFIG" = 0 ] || [ "$KEEP_CONFIG" = 1 ]; } && valid_uint "$TOTAL_SIZE" && [ "$TOTAL_SIZE" -gt 0 ]
}

set_status() {
	printf '{"stage":"%s","percent":%s,"message":"%s"}\n' "$1" "$2" "$3" > "$STATUS_FILE.$$" && mv -f "$STATUS_FILE.$$" "$STATUS_FILE"
}

cleanup() {
	[ -n "$TMP_DIR" ] && rm -rf "$TMP_DIR"
	[ -n "$CURL_PID" ] && kill "$CURL_PID" 2>/dev/null
	if [ -r "$PID_FILE" ]; then
		read -r owner < "$PID_FILE"
		[ "$owner" != "$$" ] || rm -f "$PID_FILE"
	fi
	rmdir "$WORKER_LOCK" 2>/dev/null
}


if [ "$1" = test_validate ]; then
	DOWNLOAD_URL="$2" ASSET_NAME="$3" EXPECTED_SHA256="$4" KEEP_CONFIG="$5" TOTAL_SIZE="$6"
	validate_input && printf 'ok\n' || printf 'invalid\n'
	exit 0
fi

# A contender must not touch another worker's PID or status.
WORKER_LOCK='/var/run/firmwareupgrade.worker.lock'
mkdir "$WORKER_LOCK" 2>/dev/null || exit 1
trap cleanup EXIT
trap 'set_status error 0 "升级已中断"; exit 1' INT TERM

if ! validate_input; then
	set_status error 0 '已验证的升级请求无效'
	exit 1
fi

TMP_DIR=$(mktemp -d /tmp/firmwareupgrade.XXXXXX) || {
	set_status error 0 '无法创建私有临时目录'
	exit 1
}
TARGET_FILE="$TMP_DIR/$ASSET_NAME"

set_status downloading 5 '正在连接服务器下载固件...' || exit 1
printf '%s\n' "$$" > "$PID_FILE" || exit 1
# Two-phase handshake: ready is not permission to download or flash.
# Only the launcher can grant go; timeout may kill only a waiting worker.
if [ -n "$6" ]; then
	printf '%s\n' "$$" > "$6/ready" || exit 1
	while [ ! -d "$6/go" ]; do sleep 0.1; done
	rm -f "$6/ready"
	rmdir "$6/go" "$6"
fi
# The digest and original GitHub URL remain authoritative; no token is sent.
FETCH_URL="$DOWNLOAD_URL"
[ -z "$DOWNLOAD_PROXY" ] || FETCH_URL="${DOWNLOAD_PROXY%/}/$DOWNLOAD_URL"
curl --fail --location --proto '=http,https' --proto-redir '=https' --tlsv1.2 --output "$TARGET_FILE" "$FETCH_URL" >/dev/null 2>&1 &
CURL_PID=$!
while kill -0 "$CURL_PID" 2>/dev/null; do
	if [ -s "$TARGET_FILE" ]; then
		CUR_SIZE=$(wc -c < "$TARGET_FILE" 2>/dev/null)
		if valid_uint "$CUR_SIZE"; then
			PCT=$((CUR_SIZE * 75 / TOTAL_SIZE + 5))
			[ "$PCT" -gt 80 ] && PCT=80
			set_status downloading "$PCT" '正在下载固件...'
		fi
	fi
	sleep 1
done
wait "$CURL_PID" || {
	set_status error 0 '固件下载失败，请检查网络连接'
	exit 1
}

CURL_PID=""
[ -s "$TARGET_FILE" ] && [ "$(wc -c < "$TARGET_FILE")" = "$TOTAL_SIZE" ] || {
	set_status error 0 '固件大小校验失败'
	exit 1
}

set_status verifying 85 '正在校验固件哈希完整性...'
ACTUAL_SHA256=$(sha256sum "$TARGET_FILE" | awk '{print $1}')
[ "$ACTUAL_SHA256" = "$EXPECTED_SHA256" ] || {
	set_status error 0 'SHA256 校验失败'
	exit 1
}

set_status testing 92 '正在执行镜像兼容性预检...'
sysupgrade -T "$TARGET_FILE" >/dev/null 2>&1 || {
	set_status error 0 '固件预检未通过，镜像与当前设备不兼容'
	exit 1
}

set_status flashing 100 '预检通过，正在刷写固件并重启路由器...'
if [ "$KEEP_CONFIG" = 1 ]; then
	sysupgrade "$TARGET_FILE"
else
	sysupgrade -n "$TARGET_FILE"
fi
rc=$?
[ "$rc" -eq 0 ] && set_status complete 100 '固件刷写命令已完成' || set_status error 0 '固件刷写失败，请检查设备状态'
exit "$rc"
