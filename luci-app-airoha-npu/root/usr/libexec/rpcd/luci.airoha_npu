#!/bin/sh
# Environment overrides are for isolated tests, never RPC parameters.
ROOT=${NPU_ROOT:-}
JSONFILTER=${NPU_JSONFILTER:-jsonfilter}
POLICY="$ROOT/sys/devices/system/cpu/cpufreq/policy0"

read_value() { cat "$1" 2>/dev/null; }
positive() {
	case "$1" in ''|0*|*[!0-9]*) return 1;; esac
	[ "${#1}" -le 10 ]
}
quote() {
	printf '%s' "$1" | awk 'BEGIN { for(j=1;j<32;j++) esc[sprintf("%c",j)]=sprintf("\\u%04x",j); printf "\"" } { if (NR>1) printf "\\n"; for(i=1;i<=length;i++) { c=substr($0,i,1); if(c=="\"" || c=="\\") printf "\\%s",c; else if(c=="\r") printf "\\r"; else if(c in esc) printf "%s",esc[c]; else printf "%s",c } } END { printf "\"" }'
}
number() { if positive "$1"; then printf '%s' "$1"; else printf null; fi; }
error() { printf '{"error":"%s"}\n' "$1"; }
# Exact words only; globbing is disabled inside this subshell.
contains() (
	set -f
	local word
	for word in $2; do [ "$word" = "$1" ] && return 0; done
	return 1
)
argument() {
	[ "$("$JSONFILTER" -s "$input" -t "@.$1" 2>/dev/null)" = string ] || return 1
	# Keep trailing newlines until validation rather than silently normalizing them.
	value=$("$JSONFILTER" -s "$input" -e "@.$1" 2>/dev/null; printf '.')
	value=${value%.}
	value=${value%"
"}
}
lock() {
	mkdir -p "$ROOT/var/lock" || return 1
	mkdir "$ROOT/var/lock/luci-airoha-npu" 2>/dev/null || return 1
	trap 'rmdir "$ROOT/var/lock/luci-airoha-npu" 2>/dev/null' EXIT
	trap 'exit 1' HUP INT TERM
}
set_cpu() {
	local field available old value
	case "$1" in
		governor)
			argument governor || { error invalid; return; }
			case "$value" in ''|*[!a-zA-Z0-9_-]*) error invalid; return;; esac
			field=scaling_governor; available=scaling_available_governors;;
		freq)
			argument freq && positive "$value" || { error invalid; return; }
			field=scaling_max_freq; available=scaling_available_frequencies;;
	esac
	lock || { error busy; return; }
	old=$(read_value "$POLICY/$field")
	[ -n "$old" ] && [ -w "$POLICY/$field" ] || { error unavailable; return; }
	contains "$value" "$(read_value "$POLICY/$available")" || { error invalid; return; }
	if { printf '%s\n' "$value" > "$POLICY/$field"; } 2>/dev/null &&
		[ "$(read_value "$POLICY/$field")" = "$value" ]; then
		printf '{"result":"ok"}\n'
	else
		if { printf '%s\n' "$old" > "$POLICY/$field"; } 2>/dev/null &&
			[ "$(read_value "$POLICY/$field")" = "$old" ]; then error write_failed;
		else error rollback_failed; fi
	fi
}
# Fixed, private persistent staging. Runtime is touched only by applySettings.
SETTINGS="$ROOT/etc/airoha-npu"
settings_parse() {
	argument governor || return 1
	case "$value" in ''|*[!a-zA-Z0-9_-]*) return 1;; esac
	gov=$value
	argument freq && positive "$value" || return 1
	freq=$value
}
settings_supported() {
	contains "$gov" "$(read_value "$POLICY/scaling_available_governors")" &&
	contains "$freq" "$(read_value "$POLICY/scaling_available_frequencies")"
}
settings_json() { printf '{"governor":"%s","freq":"%s"}' "$gov" "$freq"; }
settings_rpc() (
	local gov freq value tmp oldgov oldfreq ok=1
	umask 077
	[ ! -L "$SETTINGS" ] && [ ! -L "$SETTINGS/pending.json" ] || { error storage; exit; }
	[ ! -e "$SETTINGS/pending.json" ] || [ -f "$SETTINGS/pending.json" ] || { error storage; exit; }
	lock || { error busy; exit; }
	case "$1" in
		getSettings)
			if [ ! -e "$SETTINGS/pending.json" ]; then printf '{"result":"ok","pending":null}\n'; exit; fi
			[ -f "$SETTINGS/pending.json" ] || { error storage; exit; }
			input=$(cat "$SETTINGS/pending.json") && settings_parse || { error invalid; exit; }
			printf '{"result":"ok","pending":'; settings_json; printf '}\n';;
		saveSettings)
			settings_parse && settings_supported || { error invalid; exit; }
			mkdir -p "$SETTINGS" && chmod 700 "$SETTINGS" || { error storage; exit; }
			tmp=$(mktemp "$SETTINGS/.pending.XXXXXX") || { error storage; exit; }
			if ! { settings_json > "$tmp" && chmod 600 "$tmp" && mv -f "$tmp" "$SETTINGS/pending.json"; }; then
				rm -f "$tmp"; error storage; exit
			fi
			printf '{"result":"ok"}\n';;
		applySettings)
			[ -f "$SETTINGS/pending.json" ] || { error unavailable; exit; }
			input=$(cat "$SETTINGS/pending.json") && settings_parse && settings_supported || { error invalid; exit; }
			oldgov=$(read_value "$POLICY/scaling_governor")
			oldfreq=$(read_value "$POLICY/scaling_max_freq")
			contains "$oldgov" "$(read_value "$POLICY/scaling_available_governors")" &&
			contains "$oldfreq" "$(read_value "$POLICY/scaling_available_frequencies")" &&
			[ -w "$POLICY/scaling_governor" ] && [ -w "$POLICY/scaling_max_freq" ] || { error unavailable; exit; }
			if { { [ "$oldgov" = "$gov" ] || printf '%s\n' "$gov" > "$POLICY/scaling_governor"; } &&
				{ [ "$oldfreq" = "$freq" ] || printf '%s\n' "$freq" > "$POLICY/scaling_max_freq"; } &&
				[ "$(read_value "$POLICY/scaling_governor")" = "$gov" ] &&
				[ "$(read_value "$POLICY/scaling_max_freq")" = "$freq" ]; } 2>/dev/null; then
				printf '{"result":"ok"}\n'
			else
				{ printf '%s\n' "$oldfreq" > "$POLICY/scaling_max_freq"; } 2>/dev/null || ok=0
				{ printf '%s\n' "$oldgov" > "$POLICY/scaling_governor"; } 2>/dev/null || ok=0
				[ "$(read_value "$POLICY/scaling_governor")" = "$oldgov" ] &&
				[ "$(read_value "$POLICY/scaling_max_freq")" = "$oldfreq" ] || ok=0
				if [ "$ok" = 1 ]; then error write_failed; else error rollback_failed; fi
			fi;;
	esac
)
get_status() {
	local field value first=1
	printf '{'
	for field in cur_freq max_freq min_freq; do
		[ "$first" = 1 ] || printf ','; first=0
		printf '"cpu_%s":' "$field"; number "$(read_value "$POLICY/scaling_$field")"
	done
	printf ',"cpu_governor":'; quote "$(read_value "$POLICY/scaling_governor")"
	printf ',"npu_clock":'; number "$(read_value "$ROOT/sys/kernel/debug/clk/npu/clk_rate")"
	printf ',"cpu_count":'
	value=$(read_value "$ROOT/sys/devices/system/cpu/online")
	printf '%s\n' "$value" | awk '/^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$/ { n=split($0,a,","); for(i=1;i<=n;i++) { k=split(a[i],b,"-"); if(k==2 && b[2]<b[1]) exit; count+=k==2?b[2]-b[1]+1:1 } print count; ok=1 } END { if(!ok) print "null" }'
	printf ',"npu_bound":'
	if [ ! -d "$ROOT/sys/bus/platform/drivers" ]; then printf null
	else
		value=false
		for field in "$ROOT"/sys/bus/platform/drivers/airoha-npu/*.npu; do
			[ -L "$field" ] && value=true
		done
		printf '%s' "$value"
	fi
	printf '}\n'
}

get_info() {
	local compat fw='' version='' path rel
	compat=$(tr '\000' '\n' < "$ROOT/proc/device-tree/compatible" 2>/dev/null | awk 'NF { printf "%s%s", sep,$0; sep=", " }')
	# Report the DT-selected file, not a claim about running firmware.
	for path in "$ROOT"/proc/device-tree/soc/npu@*/firmware-name; do
		[ -r "$path" ] || continue
		rel=$(tr '\000' '\n' < "$path" | awk '/rv32/ { print; exit }')
		case "$rel" in ''|/*|*..*) continue;; esac
		fw="/lib/firmware/$rel"
		version=$(strings "$ROOT$fw" 2>/dev/null | awk 'match($0, /([0-9]+\.[0-9]+\.[0-9]+-)?TLB[0-9.]+[-_v0-9]*/) { print substr($0,RSTART,RLENGTH); exit }')
		break
	done
	printf '{"soc_compat":'; quote "$compat"
	printf ',"firmware_file":'; quote "$fw"
	printf ',"firmware_file_version":'; quote "$version"
	printf ',"governors":'; quote "$(read_value "$POLICY/scaling_available_governors")"
	printf ',"frequencies":'; quote "$(read_value "$POLICY/scaling_available_frequencies")"
	printf '}\n'
}

UCI=${NPU_UCI:-uci}
uci_read() { "$UCI" -q -c "$ROOT/etc/config" -C "$flow_tmp" -t "$flow_tmp" "$@"; }
get_flow() (
	local sw=0 hw=0 flow_tmp options
	umask 077
	flow_tmp=$(mktemp -d "$ROOT/tmp/luci-airoha-npu-read.XXXXXX" 2>/dev/null) || { printf '{"enabled":null}\n'; exit; }
	trap 'rm -rf "$flow_tmp"' EXIT
	trap 'exit 1' HUP INT TERM
	options=$(uci_read get 'firewall.@defaults[0]') && [ "$options" = defaults ] || { printf '{"enabled":null}\n'; return; }
	# Only confirmed absent options use firewall's disabled default.
	options=$(uci_read show 'firewall.@defaults[0]') || { printf '{"enabled":null}\n'; exit; }
	case "$options" in *.flow_offloading=*)
		sw=$(uci_read get 'firewall.@defaults[0].flow_offloading') || { printf '{"enabled":null}\n'; exit; };; esac
	case "$options" in *.flow_offloading_hw=*)
		hw=$(uci_read get 'firewall.@defaults[0].flow_offloading_hw') || { printf '{"enabled":null}\n'; exit; };; esac
	case "$sw:$hw" in
		1:1) printf '{"enabled":true}\n';;
		0:0|0:1|1:0) printf '{"enabled":false}\n';;
		*) printf '{"enabled":null}\n';;
	esac
)
case "$1" in
	list)
		printf '%s\n' '{"getSettings":{},"saveSettings":{"governor":"str","freq":"str"},"applySettings":{},"getStatus":{},"getInfo":{},"getFlowOffload":{},"setGovernor":{"governor":"str"},"setMaxFreq":{"freq":"str"}}';;
	call)
		input=$(cat)
		case "$2" in
			getSettings|saveSettings|applySettings) settings_rpc "$2";;
			getStatus) get_status;;
			getInfo) get_info;;
			getFlowOffload) get_flow;;
			setGovernor) set_cpu governor;;
			setMaxFreq) set_cpu freq;;
			*) error unsupported;;
		esac;;
esac
