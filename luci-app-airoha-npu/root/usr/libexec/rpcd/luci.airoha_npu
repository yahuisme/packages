#!/bin/sh
# Environment overrides are for isolated tests, never RPC parameters.
ROOT=${NPU_ROOT:-}
JSONFILTER=${NPU_JSONFILTER:-jsonfilter}
POLICY="$ROOT/sys/devices/system/cpu/cpufreq/policy0"

read_value() { cat "$1" 2>/dev/null; }
positive() {
	case "$1" in ''|0*|*[!0-9]*) return 1;; esac
	[ "${#1}" -le 10 ]
}
quote() {
	printf '%s' "$1" | awk 'BEGIN { for(j=1;j<32;j++) esc[sprintf("%c",j)]=sprintf("\\u%04x",j); printf "\"" } { if (NR>1) printf "\\n"; for(i=1;i<=length;i++) { c=substr($0,i,1); if(c=="\"" || c=="\\") printf "\\%s",c; else if(c=="\t") printf "\\t"; else if(c=="\r") printf "\\r"; else if(c in esc) printf "%s",esc[c]; else printf "%s",c } } END { printf "\"" }'
}
number() { if positive "$1"; then printf '%s' "$1"; else printf null; fi; }
error() { printf '{"error":"%s"}\n' "$1"; }
# Exact words only; globbing is disabled inside this subshell.
contains() (
	set -f
	local word
	for word in $2; do [ "$word" = "$1" ] && return 0; done
	return 1
)
argument() {
	[ "$("$JSONFILTER" -s "$input" -t "@.$1" 2>/dev/null)" = string ] || return 1
	# Keep trailing newlines until validation rather than silently normalizing them.
	value=$("$JSONFILTER" -s "$input" -e "@.$1" 2>/dev/null; printf '.')
	value=${value%.}
	value=${value%"
"}
}
lock() {
	mkdir -p "$ROOT/var/lock" || return 1
	mkdir "$ROOT/var/lock/luci-airoha-npu" 2>/dev/null || return 1
	trap 'rmdir "$ROOT/var/lock/luci-airoha-npu" 2>/dev/null' EXIT
	trap 'exit 1' HUP INT TERM
}
set_cpu() {
	local field available old value
	case "$1" in
		governor)
			argument governor || { error invalid; return; }
			case "$value" in ''|*[!a-zA-Z0-9_-]*) error invalid; return;; esac
			field=scaling_governor; available=scaling_available_governors;;
		freq)
			argument freq && positive "$value" || { error invalid; return; }
			field=scaling_max_freq; available=scaling_available_frequencies;;
	esac
	lock || { error busy; return; }
	old=$(read_value "$POLICY/$field")
	[ -n "$old" ] && [ -w "$POLICY/$field" ] || { error unavailable; return; }
	contains "$value" "$(read_value "$POLICY/$available")" || { error invalid; return; }
	if { printf '%s\n' "$value" > "$POLICY/$field"; } 2>/dev/null &&
		[ "$(read_value "$POLICY/$field")" = "$value" ]; then
		printf '{"result":"ok"}\n'
	else
		if { printf '%s\n' "$old" > "$POLICY/$field"; } 2>/dev/null &&
			[ "$(read_value "$POLICY/$field")" = "$old" ]; then error write_failed;
		else error rollback_failed; fi
	fi
}
get_status() {
	local field value first=1
	printf '{'
	for field in cur_freq max_freq min_freq; do
		[ "$first" = 1 ] || printf ','; first=0
		printf '"cpu_%s":' "$field"; number "$(read_value "$POLICY/scaling_$field")"
	done
	printf ',"cpu_governor":'; quote "$(read_value "$POLICY/scaling_governor")"
	printf ',"npu_clock":'; number "$(read_value "$ROOT/sys/kernel/debug/clk/npu/clk_rate")"
	printf ',"cpu_count":'
	value=$(read_value "$ROOT/sys/devices/system/cpu/online")
	printf '%s\n' "$value" | awk '/^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$/ { n=split($0,a,","); for(i=1;i<=n;i++) { k=split(a[i],b,"-"); if(k==2 && b[2]<b[1]) exit; count+=k==2?b[2]-b[1]+1:1 } print count; ok=1 } END { if(!ok) print "null" }'
	printf ',"npu_bound":'
	if [ ! -d "$ROOT/sys/bus/platform/drivers" ]; then printf null
	else
		value=false
		for field in "$ROOT"/sys/bus/platform/drivers/airoha-npu/*.npu; do
			[ -L "$field" ] && value=true
		done
		printf '%s' "$value"
	fi
	printf '}\n'
}

get_info() {
	local compat fw='' version='' path rel
	compat=$(tr '\000' '\n' < "$ROOT/proc/device-tree/compatible" 2>/dev/null | awk 'NF { printf "%s%s", sep,$0; sep=", " }')
	# Report the DT-selected file, not a claim about running firmware.
	for path in "$ROOT"/proc/device-tree/soc/npu@*/firmware-name; do
		[ -r "$path" ] || continue
		rel=$(tr '\000' '\n' < "$path" | awk '/rv32/ { print; exit }')
		case "$rel" in ''|/*|*..*) continue;; esac
		fw="/lib/firmware/$rel"
		version=$(strings "$ROOT$fw" 2>/dev/null | awk 'match($0, /([0-9]+\.[0-9]+\.[0-9]+-)?TLB[0-9.]+[-_v0-9]*/) { print substr($0,RSTART,RLENGTH); exit }')
		break
	done
	printf '{"soc_compat":'; quote "$compat"
	printf ',"firmware_file":'; quote "$fw"
	printf ',"firmware_file_version":'; quote "$version"
	printf ',"governors":'; quote "$(read_value "$POLICY/scaling_available_governors")"
	printf ',"frequencies":'; quote "$(read_value "$POLICY/scaling_available_frequencies")"
	printf '}\n'
}

UCI=${NPU_UCI:-uci}
FIREWALL=${NPU_FIREWALL:-/etc/init.d/firewall}
uci_read() { "$UCI" -q -c "$ROOT/etc/config" -P "$ROOT/tmp/luci-airoha-npu-read" "$@"; }
get_flow() {
	local sw hw
	[ "$(uci_read get 'firewall.@defaults[0]')" = defaults ] || { printf '{"enabled":null}\n'; return; }
	sw=$(uci_read get 'firewall.@defaults[0].flow_offloading')
	hw=$(uci_read get 'firewall.@defaults[0].flow_offloading_hw')
	case "$sw:$hw" in
		1:1) printf '{"enabled":true}\n';;
		*[!01:]*) printf '{"enabled":null}\n';;
		*) printf '{"enabled":false}\n';;
	esac
}
replace_config() {
	local stage
	stage=$(mktemp "$ROOT/etc/config/.npu-firewall.XXXXXX") || return 1
	if cp -p "$1" "$stage" && mv -f "$stage" "$ROOT/etc/config/firewall"; then return 0; fi
	rm -f "$stage"
	return 1
}
set_flow() {
	local value config="$ROOT/etc/config/firewall" changes
	argument enabled || { error invalid; return; }
	case "$value" in 0|1) ;; *) error invalid; return;; esac
	lock || { error busy; return; }
	# Refuse pending LuCI/CLI edits rather than committing someone else's work.
	changes=$("$UCI" -q -c "$ROOT/etc/config" changes firewall) || { error unavailable; return; }
	[ -z "$changes" ] || { error pending_changes; return; }
	work=$(mktemp -d "$ROOT/tmp/luci-airoha-npu.XXXXXX") || { error unavailable; return; }
	trap 'rm -rf "$work"; rmdir "$ROOT/var/lock/luci-airoha-npu" 2>/dev/null' EXIT
	mkdir "$work/delta" || { error unavailable; return; }
	cp -p "$config" "$work/original" && cp -p "$config" "$work/firewall" || { error unavailable; return; }
	# Stage in a private configuration directory, preserving absent options and unrelated settings.
	if ! "$UCI" -q -c "$work" -t "$work/delta" set "firewall.@defaults[0].flow_offloading=$value" ||
		! "$UCI" -q -c "$work" -t "$work/delta" set "firewall.@defaults[0].flow_offloading_hw=$value" ||
		! "$UCI" -q -c "$work" -t "$work/delta" commit firewall; then error write_failed; return; fi
	cmp -s "$config" "$work/original" || { error busy; return; }
	if replace_config "$work/firewall" &&
		[ "$(uci_read get 'firewall.@defaults[0].flow_offloading')" = "$value" ] &&
		[ "$(uci_read get 'firewall.@defaults[0].flow_offloading_hw')" = "$value" ] &&
		"$FIREWALL" reload >/dev/null 2>&1; then
		printf '{"result":"ok"}\n'
	elif replace_config "$work/original" && cmp -s "$config" "$work/original" &&
		"$FIREWALL" reload >/dev/null 2>&1; then error write_failed
	else error rollback_failed; fi
}

case "$1" in
	list)
		printf '%s\n' '{"getStatus":{},"getInfo":{},"getFlowOffload":{},"setFlowOffload":{"enabled":"str"},"setGovernor":{"governor":"str"},"setMaxFreq":{"freq":"str"}}';;
	call)
		input=$(cat)
		case "$2" in
			getStatus) get_status;;
			getInfo) get_info;;
			getFlowOffload) get_flow;;
			setFlowOffload) set_flow;;
			setGovernor) set_cpu governor;;
			setMaxFreq) set_cpu freq;;
			*) error unsupported;;
		esac;;
esac
