#!/bin/sh
# Environment overrides are for isolated tests, never RPC parameters.
ROOT=${NPU_ROOT:-}
JSONFILTER=${NPU_JSONFILTER:-jsonfilter}
POLICY="$ROOT/sys/devices/system/cpu/cpufreq/policy0"

read_value() { cat "$1" 2>/dev/null; }
# CPUFreq's QoS store queues policy work. Allow up to 250 ms for readback,
# with no retry of writes and no background worker (six reads, five sleeps).
wait_max_freq() {
	local remaining=5
	while :; do
		[ "$(read_value "$POLICY/scaling_max_freq")" = "$1" ] && return 0
		[ "$remaining" -gt 0 ] || return 1
		sleep 0.05 || return 1
		remaining=$((remaining - 1))
	done
}
positive() {
	case "$1" in ''|0*|*[!0-9]*) return 1;; esac
	[ "${#1}" -le 10 ]
}
# Printable ASCII naming and number lists are escaped by nothing, so the common
# case needs no child. Anything else keeps the original awk path.
quote() {
	case "$1" in
	*[!A-Za-z0-9\ _,.:/-]*) ;;
	*) printf '"%s"' "$1"; return 0;;
	esac
	printf '%s' "$1" | awk 'BEGIN { for(j=1;j<32;j++) esc[sprintf("%c",j)]=sprintf("\\u%04x",j); printf "\"" } { if (NR>1) printf "\\n"; for(i=1;i<=length;i++) { c=substr($0,i,1); if(c=="\"" || c=="\\") printf "\\%s",c; else if(c=="\r") printf "\\r"; else if(c in esc) printf "%s",esc[c]; else printf "%s",c } } END { printf "\"" }'
}
number() { if positive "$1"; then printf '%s' "$1"; else printf null; fi; }
error() { printf '{"error":"%s"}\n' "$1"; }
# Exact words only; globbing is disabled inside this subshell.
contains() (
	set -f
	local word
	for word in $2; do [ "$word" = "$1" ] && return 0; done
	return 1
)
argument() {
	[ "$("$JSONFILTER" -s "$input" -t "@.$1" 2>/dev/null)" = string ] || return 1
	# Keep trailing newlines until validation rather than silently normalizing them.
	value=$("$JSONFILTER" -s "$input" -e "@.$1" 2>/dev/null; printf '.')
	value=${value%.}
	value=${value%"
"}
}
lock() {
	command -v flock >/dev/null 2>&1 || return 1
	mkdir -p "$ROOT/var/lock" || return 1
	# Separate from the legacy mkdir lock; never unlink/replace a held inode.
	# command makes an open failure recoverable in ash (plain exec exits).
	{ command exec 9>> "$ROOT/var/lock/luci-airoha-npu.lock"; } 2>/dev/null || return 1
	flock -n 9 2>/dev/null || return 1
	# settings_rpc and its short-lived children inherit fd 9. The kernel
	# releases the lock on last close, including owner/child SIGKILL.
	trap 'exit 1' HUP INT TERM
}
# Fixed, private persistent staging. Runtime is touched only by applySettings.
SETTINGS="$ROOT/etc/airoha-npu"
settings_parse() {
	argument governor || return 1
	case "$value" in ''|*[!a-zA-Z0-9_-]*) return 1;; esac
	gov=$value
	argument freq && positive "$value" || return 1
	freq=$value
}
settings_supported() {
	contains "$gov" "$(read_value "$POLICY/scaling_available_governors")" &&
	contains "$freq" "$(read_value "$POLICY/scaling_available_frequencies")"
}
settings_json() { printf '{"governor":"%s","freq":"%s"}' "$gov" "$freq"; }
settings_rpc() (
	local gov freq value tmp oldgov oldfreq expected= expected_json= ok=1
	umask 077
	[ ! -L "$SETTINGS" ] && [ ! -L "$SETTINGS/pending.json" ] || { error storage; exit; }
	[ ! -e "$SETTINGS/pending.json" ] || [ -f "$SETTINGS/pending.json" ] || { error storage; exit; }
	lock || { error busy; exit; }
	case "$1" in
		getSettings)
			if [ ! -e "$SETTINGS/pending.json" ]; then printf '{"result":"ok","pending":null}\n'; exit; fi
			[ -f "$SETTINGS/pending.json" ] || { error storage; exit; }
			input=$(cat "$SETTINGS/pending.json") && settings_parse || { error invalid; exit; }
			printf '{"result":"ok","pending":'; settings_json; printf '}\n';;
		saveSettings)
			settings_parse && settings_supported || { error invalid; exit; }
			mkdir -p "$SETTINGS" && chmod 700 "$SETTINGS" || { error storage; exit; }
			tmp=$(mktemp "$SETTINGS/.pending.XXXXXX") || { error storage; exit; }
			if ! { settings_json > "$tmp" && chmod 600 "$tmp" && mv -f "$tmp" "$SETTINGS/pending.json"; }; then
				rm -f "$tmp"; error storage; exit
			fi
			printf '{"result":"ok"}\n';;
		applySettings)
			if [ -n "$("$JSONFILTER" -s "$input" -t '@.expected' 2>/dev/null)" ]; then
				argument expected || { error invalid; exit; }
				expected=$value; input=$expected
				settings_parse || { error invalid; exit; }
				expected_json=$(settings_json)
			fi
			[ -f "$SETTINGS/pending.json" ] || { error unavailable; exit; }
			input=$(cat "$SETTINGS/pending.json") && settings_parse && settings_supported || { error invalid; exit; }
			# Reject a newer session's saved pair before touching either CPU field.
			[ -z "$expected_json" ] || [ "$(settings_json)" = "$expected_json" ] || { error busy; exit; }
			oldgov=$(read_value "$POLICY/scaling_governor")
			oldfreq=$(read_value "$POLICY/scaling_max_freq")
			contains "$oldgov" "$(read_value "$POLICY/scaling_available_governors")" &&
			contains "$oldfreq" "$(read_value "$POLICY/scaling_available_frequencies")" &&
			[ -w "$POLICY/scaling_governor" ] && [ -w "$POLICY/scaling_max_freq" ] || { error unavailable; exit; }
			if { { [ "$oldgov" = "$gov" ] || printf '%s\n' "$gov" > "$POLICY/scaling_governor"; } &&
				{ [ "$oldfreq" = "$freq" ] || printf '%s\n' "$freq" > "$POLICY/scaling_max_freq"; } &&
				[ "$(read_value "$POLICY/scaling_governor")" = "$gov" ] &&
				wait_max_freq "$freq"; } 2>/dev/null; then
				printf '{"result":"ok"}\n'
			else
				{ printf '%s\n' "$oldfreq" > "$POLICY/scaling_max_freq"; } 2>/dev/null || ok=0
				{ printf '%s\n' "$oldgov" > "$POLICY/scaling_governor"; } 2>/dev/null || ok=0
				[ "$(read_value "$POLICY/scaling_governor")" = "$oldgov" ] &&
				wait_max_freq "$oldfreq" || ok=0
				if [ "$ok" = 1 ]; then error write_failed; else error rollback_failed; fi
			fi;;
	esac
)
# Status-only text read. Keeps every line (including an unterminated last line)
# and drops trailing newlines exactly as a command substitution does, but leaves
# the bytes in status_text: the poll must not pay for a capturing subshell.
# Keep transaction read_value and its exit-status semantics untouched.
read_status_text() {
	local line
	status_text=
	{
		while IFS= read -r line || [ -n "$line" ]; do
			status_text="$status_text$line
"
		done < "$1"
	} 2>/dev/null
	while :; do
		case "$status_text" in
			*"
") status_text="${status_text%
}" ;;
			*) return 0 ;;
		esac
	done
}
# Numeric status fields are single-line sysfs words. Read them into the caller's
# shell with builtins only: a 3 s poll must not pay for a subshell per field.
read_word() {
	local extra
	word=
	{ IFS= read -r word; IFS= read -r extra; } 2>/dev/null < "$1"
	[ -z "$extra" ] || word=
}
# Same counting as the previous per-poll awk pass, without the pipeline.
cpu_count() {
	local list=$1 part lo hi total=0
	case "$list" in ''|*[!0-9,-]*|,*|*,|*,,*) printf null; return 0;; esac
	local IFS=,
	for part in $list; do
		case "$part" in
			*-*)
				lo=${part%%-*}; hi=${part#*-}
				case "$lo$hi" in ''|*[!0-9]*) printf null; return 0;; esac
				[ "$hi" -ge "$lo" ] || { printf null; return 0; }
				total=$((total + hi - lo + 1));;
			*) total=$((total + 1));;
		esac
	done
	printf '%s' "$total"
}
get_status() {
	local field value word status_text
	printf '{"cpu_cur_freq":'; read_word "$POLICY/scaling_cur_freq"; number "$word"
	printf ',"cpu_max_freq":'; read_word "$POLICY/scaling_max_freq"; number "$word"
	printf ',"cpu_min_freq":'; read_word "$POLICY/scaling_min_freq"; number "$word"
	printf ',"cpu_governor":'; read_status_text "$POLICY/scaling_governor"; quote "$status_text"
	printf ',"npu_clock":'; read_word "$ROOT/sys/kernel/debug/clk/npu/clk_rate"; number "$word"
	printf ',"cpu_count":'; read_word "$ROOT/sys/devices/system/cpu/online"; cpu_count "$word"
	printf ',"npu_bound":'
	if [ ! -d "$ROOT/sys/bus/platform/drivers" ]; then printf null
	else
		value=false
		for field in "$ROOT"/sys/bus/platform/drivers/airoha-npu/*.npu; do
			[ -L "$field" ] && value=true
		done
		printf '%s' "$value"
	fi
	printf '}\n'
}

get_info() {
	local compat fw='' version='' path rel
	compat=$(tr '\000' '\n' < "$ROOT/proc/device-tree/compatible" 2>/dev/null | awk 'NF { printf "%s%s", sep,$0; sep=", " }')
	# Report the DT-selected file, not a claim about running firmware.
	for path in "$ROOT"/proc/device-tree/soc/npu@*/firmware-name; do
		[ -r "$path" ] || continue
		rel=$(tr '\000' '\n' < "$path" | awk '/rv32/ { print; exit }')
		case "$rel" in ''|/*|*..*) continue;; esac
		fw="/lib/firmware/$rel"
		version=$(strings "$ROOT$fw" 2>/dev/null | awk 'match($0, /([0-9]+\.[0-9]+\.[0-9]+-)?TLB[0-9.]+[-_v0-9]*/) { print substr($0,RSTART,RLENGTH); exit }')
		break
	done
	printf '{"soc_compat":'; quote "$compat"
	printf ',"firmware_file":'; quote "$fw"
	printf ',"firmware_file_version":'; quote "$version"
	printf ',"governors":'; quote "$(read_value "$POLICY/scaling_available_governors")"
	printf ',"frequencies":'; quote "$(read_value "$POLICY/scaling_available_frequencies")"
	printf '}\n'
}

UCI=${NPU_UCI:-uci}
get_flow() (
	local sw=0 hw=0 flow_tmp options
	umask 077
	flow_tmp=$(mktemp -d "$ROOT/tmp/luci-airoha-npu-read.XXXXXX" 2>/dev/null) || { printf '{"enabled":null}\n'; exit; }
	trap 'rm -rf "$flow_tmp"' EXIT
	trap 'exit 1' HUP INT TERM
	options=$("$UCI" -q -c "$ROOT/etc/config" -C "$flow_tmp" -t "$flow_tmp" get 'firewall.@defaults[0]') && [ "$options" = defaults ] || { printf '{"enabled":null}\n'; return; }
	# Only confirmed absent options use firewall's disabled default.
	options=$("$UCI" -q -c "$ROOT/etc/config" -C "$flow_tmp" -t "$flow_tmp" show 'firewall.@defaults[0]') || { printf '{"enabled":null}\n'; exit; }
	case "$options" in *.flow_offloading=*)
		sw=$("$UCI" -q -c "$ROOT/etc/config" -C "$flow_tmp" -t "$flow_tmp" get 'firewall.@defaults[0].flow_offloading') || { printf '{"enabled":null}\n'; exit; };; esac
	case "$options" in *.flow_offloading_hw=*)
		hw=$("$UCI" -q -c "$ROOT/etc/config" -C "$flow_tmp" -t "$flow_tmp" get 'firewall.@defaults[0].flow_offloading_hw') || { printf '{"enabled":null}\n'; exit; };; esac
	case "$sw:$hw" in
		1:1) printf '{"enabled":true}\n';;
		0:0|0:1|1:0) printf '{"enabled":false}\n';;
		*) printf '{"enabled":null}\n';;
	esac
)
# Official airoha_ppe_debugfs.c: bind emits one BND row per bound FOE entry.
# Stream the rows; never treat entries output length as hardware capacity.
get_ppe() {
	local count
	[ -r "$ROOT/sys/kernel/debug/ppe/bind" ] && [ ! -d "$ROOT/sys/kernel/debug/ppe/bind" ] || { printf '{"bound_entries":null}\n'; return; }
	count=$(awk '
		length($1) != 5 || $1 ~ /[^0-9a-f]/ || $2 != "BND" || NF < 3 { bad=1; exit }
		{ count++ }
		END { if (!bad) print count+0; else exit 1 }
	' "$ROOT/sys/kernel/debug/ppe/bind" 2>/dev/null) || count=null
	printf '{"bound_entries":%s}\n' "$count"
}
case "$1" in
	list)
		printf '%s\n' '{"getSettings":{},"saveSettings":{"governor":"str","freq":"str"},"applySettings":{"expected":"str"},"getStatus":{},"getInfo":{},"getFlowOffload":{},"getPpeStatus":{}}';;
	call)
		input=$(cat)
		case "$2" in
			getSettings|saveSettings|applySettings) settings_rpc "$2";;
			getStatus) get_status;;
			getInfo) get_info;;
			getFlowOffload) get_flow;;
			getPpeStatus) get_ppe;;
			*) error unsupported;;
		esac;;
esac
