USE_PROCD=1

START=99
STOP=10

CONF="homeproxy"
PROG="/usr/bin/sing-box"

HP_DIR="/etc/homeproxy"
RUN_DIR="/var/run/homeproxy"
LOG_PATH="$RUN_DIR/homeproxy.log"
CACHE_DIR="$HP_DIR/cache"
DASHBOARD_DIR="$HP_DIR/dashboard"
CRON_FILE="/etc/crontabs/root"
CRON_LOCK="/var/lock/root-crontab"
CRON_TAG="#${CONF}_autosetup"

# Follow native OpenWrt/ImmortalWrt dnsmasq_start order, skipping disabled
# sections. The optional ubus name isn't evidence that an instance is active:
# its name callback runs before UCI options have been loaded.
dnsmasq_select() {
	local disabled
	[ -z "$dnsmasq_section" ] || return 0
	config_get_bool disabled "$1" disabled 0
	[ "$disabled" -ne 0 ] || dnsmasq_section="$1"
}

# Mirror dnsmasq's required (*suffix) and excluded (suffix) lists.
dnsmasq_accepts() {
	local name="$1" filters="$2" suffix required=0 matched=0
	while [ -n "$filters" ]; do
		suffix="${filters%%,*}"
		case "$filters" in *,*) filters="${filters#*,}" ;; *) filters='' ;; esac
		case "$suffix" in
		''|'*') ;;
		\**) required=1; case "$name" in ?*"${suffix#\*}") matched=1 ;; esac ;;
		*) case "$name" in ?*"$suffix") return 1 ;; esac ;;
		esac
	done
	[ "$required" -eq 0 ] || [ "$matched" -eq 1 ]
}

dnsmasq_path() {
	case "$1" in
	/*) ;;
	*) return 1 ;;
	esac
	# Not representable as a literal dnsmasq conf-dir or marker line.
	case "$1" in *[[:cntrl:],#\"\\]*|*[[:space:]]) return 1 ;; esac
}

dnsmasq_shared_dir() {
	local disabled spec other filters
	[ "$1" != "$dnsmasq_section" ] || return 0
	config_get_bool disabled "$1" disabled 0
	[ "$disabled" -eq 0 ] || return 0
	config_get spec "$1" confdir "/tmp/dnsmasq.$1.d"
	other="${spec%%,*}"
	dnsmasq_path "$other" || return 0
	if [ -d "$other" ]; then
		other="$(cd -P -- "$other" && pwd -P)" || return 0
	fi
	other="${other%/}"
	[ "$other" = "$dnsmasq_parent" ] || return 0
	filters=''
	case "$spec" in *,*) filters="${spec#*,}" ;; esac
	if dnsmasq_accepts "$dnsmasq_name" "$filters"; then shared=1; fi
}

dnsmasq_discover() {
	local dnsmasq_section='' spec filters='' candidates suffix port dnsmasq_parent dnsmasq_name shared=0 name
	DNSMASQ_DIR='' DNSMASQ_INCLUDE='' DNSMASQ_SECTION='' DNSMASQ_SPEC=''
	config_load dhcp || return 0
	config_foreach dnsmasq_select dnsmasq
	[ -n "$dnsmasq_section" ] || return 0
	case "$dnsmasq_section" in *[!a-zA-Z0-9_]*) return 0 ;; esac
	config_get port "$dnsmasq_section" port 53
	[ "$port" != 0 ] || return 0
	config_get spec "$dnsmasq_section" confdir "/tmp/dnsmasq.$dnsmasq_section.d"
	dnsmasq_parent="${spec%%,*}"
	dnsmasq_path "$dnsmasq_parent" || return 0
	# Resolve aliases where native dnsmasq already created the directory.
	# Missing directories retain their configured identity until install.
	if [ -d "$dnsmasq_parent" ]; then
		dnsmasq_parent="$(cd -P -- "$dnsmasq_parent" && pwd -P)" || return 0
	fi
	dnsmasq_parent="${dnsmasq_parent%/}"
	[ -n "$dnsmasq_parent" ] && dnsmasq_path "$dnsmasq_parent" || return 0
	case "$spec" in *,*) filters="${spec#*,}" ;; esac
	dnsmasq_name='dnsmasq-homeproxy.conf'
	if ! dnsmasq_accepts "$dnsmasq_name" "$filters"; then
		candidates="$filters"
		dnsmasq_name=''
		while [ -n "$candidates" ]; do
			suffix="${candidates%%,*}"
			case "$candidates" in *,*) candidates="${candidates#*,}" ;; *) candidates='' ;; esac
			case "$suffix" in
			\*?*) suffix="${suffix#\*}" ;;
			*) continue ;;
			esac
			case "$suffix" in *[!a-zA-Z0-9._-]*) continue ;; esac
			name="dnsmasq-homeproxy$suffix"
			[ "$name" != dnsmasq-homeproxy.d ] || name="dnsmasq-homeproxy-include$suffix"
			if dnsmasq_accepts "$name" "$filters"; then
				dnsmasq_name="$name"
				break
			fi
		done
		# With exclusion-only filters, an extensionless name may still work.
		if [ -z "$dnsmasq_name" ] && dnsmasq_accepts dnsmasq-homeproxy "$filters"; then
			dnsmasq_name='dnsmasq-homeproxy'
		fi
	fi
	[ -n "$dnsmasq_name" ] || return 0
	config_foreach dnsmasq_shared_dir dnsmasq
	[ "$shared" -eq 0 ] || return 0
	DNSMASQ_DIR="$dnsmasq_parent/dnsmasq-homeproxy.d"
	DNSMASQ_INCLUDE="$dnsmasq_parent/$dnsmasq_name"
	DNSMASQ_SECTION="$dnsmasq_section" DNSMASQ_SPEC="$spec"
}

# The older implementation wrote into the first section, even if disabled,
# and invented a conf-dir for relative paths. Recover that exact legacy
# include only when the adjacent redirect proves it was ours.
dnsmasq_legacy_section() {
	[ -n "$legacy_parent" ] && return 0
	config_get legacy_parent "$1" confdir
	legacy_parent="${legacy_parent%%,*}"
	case "$legacy_parent" in /*) ;; *) legacy_parent="/tmp/dnsmasq.$1.d" ;; esac
}

log() {
	printf '%s [DAEMON] %s\n' "$(date "+%Y-%m-%d %H:%M:%S")" "$*" >> "$LOG_PATH"
}

homeproxy_prepare_runtime() {
	# Only root may replace runtime entries. The server needs writable log
	# bytes, not ownership of the parent, configs, locks or recovery copies.
	[ ! -L "$RUN_DIR" ] || return 1
	mkdir -p "$RUN_DIR" && chown root:root "$RUN_DIR" && chmod 755 "$RUN_DIR" || return 1
	if [ -e "$RUN_DIR/latency-test" ] || [ -L "$RUN_DIR/latency-test" ]; then
		[ -d "$RUN_DIR/latency-test" ] && [ ! -L "$RUN_DIR/latency-test" ] &&
			chown root:root "$RUN_DIR/latency-test" && chmod 700 "$RUN_DIR/latency-test" || return 1
	fi
	ucode -e '
		import { logNames, prepareFiles } from "/etc/homeproxy/scripts/runtime-files.uc";
		prepareFiles(ARGV[0], map(logNames, name => name + ".log"), "homeproxy.log", 0644);
	' "$RUN_DIR"
}

clear_firewall() {
	: > "$RUN_DIR/fw4_input.nft" || return 1
	fw4 reload >"/dev/null" 2>&1
}

dnsmasq_previous() {
	local state="$RUN_DIR/dnsmasq.include" legacy_parent='' dir include
	HP_DNS_PREVIOUS=''
	if [ ! -e "$state" ] && [ ! -L "$state" ]; then
		config_foreach dnsmasq_legacy_section dnsmasq
		[ -n "$legacy_parent" ] || return 0
		dnsmasq_path "$legacy_parent" || return 0
		dir="${legacy_parent%/}/dnsmasq-homeproxy.d"
		include="${legacy_parent%/}/dnsmasq-homeproxy.conf"
		if [ -f "$include" ] && [ ! -L "$include" ] && [ ! -L "$dir" ] &&
		   [ -f "$dir/redirect-dns.conf" ] && [ ! -L "$dir/redirect-dns.conf" ] &&
		   printf 'conf-dir=%s\n' "$dir" | cmp -s - "$include" &&
		   grep -q '^server=127\.0\.0\.1#[0-9][0-9]*$' "$dir/redirect-dns.conf"; then
			legacy_parent="$(cd -P -- "$legacy_parent" && pwd -P)" || return 1
			HP_DNS_PREVIOUS="${legacy_parent%/}/dnsmasq-homeproxy.conf"
		fi
		return 0
	fi
	[ -f "$state" ] && [ ! -L "$state" ] && [ -O "$state" ] && IFS= read -r HP_DNS_PREVIOUS < "$state" || return 1
	dnsmasq_path "$HP_DNS_PREVIOUS" || return 1
	case "${HP_DNS_PREVIOUS##*/}" in
	dnsmasq-homeproxy*[!a-zA-Z0-9._-]*) return 1 ;;
	dnsmasq-homeproxy*) ;;
	*) return 1 ;;
	esac
	printf '%s\n' "$HP_DNS_PREVIOUS" | cmp -s - "$state"
}

dnsmasq_remove() {
	local include="$1" dir="$2"
	if [ -n "$include" ] && { [ -e "$include" ] || [ -L "$include" ]; }; then
		HP_DNS_CHANGED=1
		rm -f "$include" || return 1
	fi
	if [ -n "$dir" ] && { [ -e "$dir" ] || [ -L "$dir" ]; }; then
		HP_DNS_CHANGED=1
		rm -rf "$dir" || return 1
	fi
}

# Atomic same-directory replacements, ignored by dnsmasq until installed.
dnsmasq_write() {
	local path="$1" tmp
	[ ! -e "$path" ] || [ -f "$path" ] || return 1
	tmp="$(mktemp "${path%/*}/.homeproxy.XXXXXX")" || return 1
	if ! cat > "$tmp" || ! chmod 644 "$tmp" || ! mv -f "$tmp" "$path"; then
		rm -f "$tmp"
		return 1
	fi
}

# procd may report the ujail launcher as running before dnsmasq has even
# parsed its options. Match the selected instance and its actual daemon,
# and require the native dnsmasq privilege drop (after startup/config load).
dnsmasq_launcher() {
	local state
	state="$(ubus -t 1 call service list '{"name":"dnsmasq"}')" || return 1
	# A successful list can have no entry (e.g. first start).
	jsonfilter -s "$state" -e "@.dnsmasq.instances['$DNSMASQ_SECTION'].pid" || [ "$?" -eq 1 ]
}

dnsmasq_ready() {
	local launcher="$1" include="$2" pid root expected config="/var/etc/dnsmasq.conf.$DNSMASQ_SECTION"
	expected="$(printf '%s\n' /usr/sbin/dnsmasq -C "$config" -k -x "/var/run/dnsmasq/dnsmasq.$DNSMASQ_SECTION.pid")"
	for pid in $(pidof dnsmasq); do
		root="/proc/$pid"
		[ "$pid" = "$launcher" ] || grep -Eq "^PPid:[[:space:]]+$launcher$" "$root/status" || continue
		grep -Eq '^Uid:[[:space:]]+[1-9][0-9]*[[:space:]]' "$root/status" || continue
		[ "$(tr '\000' '\n' < "$root/cmdline")" = "$expected" ] || continue
		grep -Fqx "conf-dir=$DNSMASQ_SPEC" "$root/root$config" || continue
		if [ -n "$include" ]; then
			[ -s "$root/root$include" ] && cmp -s "$include" "$root/root$include" &&
				cmp -s "$DNSMASQ_DIR/redirect-dns.conf" "$root/root$DNSMASQ_DIR/redirect-dns.conf" || continue
		fi
		return 0
	done 2>/dev/null
	return 1
}

dnsmasq_restart() {
	local include="$1" before after attempt
	[ -n "$DNSMASQ_SECTION" ] || return 1
	before="$(dnsmasq_launcher)" || return 1
	/etc/init.d/dnsmasq restart >/dev/null 2>&1 || return 1
	# rc.common/procd can mask a failed submission. Bound the readiness wait;
	# a surviving old instance is not evidence that these files were loaded.
	for attempt in 0 1 2 3 4 5; do
		[ "$attempt" -eq 0 ] || sleep 1
		after="$(dnsmasq_launcher)" || continue
		case "$after" in ''|0*|*[!0-9]*) continue ;; esac
		[ "$after" != "$before" ] && dnsmasq_ready "$after" "$include" && return 0
	done
	return 1
}

apply_dnsmasq() {
	local enabled="$1" port="$2" previous_dir='' legacy='' include=''
	[ -z "$HP_DNS_PREVIOUS" ] || previous_dir="${HP_DNS_PREVIOUS%/*}/dnsmasq-homeproxy.d"
	[ -z "$DNSMASQ_DIR" ] || legacy="${DNSMASQ_DIR%/*}/dnsmasq-homeproxy.conf"
	if [ "$enabled" -eq 1 ]; then
		[ -n "$DNSMASQ_INCLUDE" ] || return 1
		include="$DNSMASQ_INCLUDE"
		case "$port" in ''|*[!0-9]*) return 1 ;; esac
		if [ "$HP_DNS_PREVIOUS" != "$DNSMASQ_INCLUDE" ]; then
			[ "$previous_dir" != "$DNSMASQ_DIR" ] || previous_dir=''
			dnsmasq_remove "$HP_DNS_PREVIOUS" "$previous_dir" || return 1
		fi
		[ "$legacy" = "$DNSMASQ_INCLUDE" ] || dnsmasq_remove "$legacy" '' || return 1
		[ ! -L "$DNSMASQ_DIR" ] && [ ! -L "$DNSMASQ_INCLUDE" ] &&
			[ ! -L "$DNSMASQ_DIR/redirect-dns.conf" ] || return 1
		if ! printf 'conf-dir=%s\n' "$DNSMASQ_DIR" | cmp -s - "$DNSMASQ_INCLUDE" ||
		   ! printf 'no-poll\nno-resolv\nserver=127.0.0.1#%s\n' "$port" | cmp -s - "$DNSMASQ_DIR/redirect-dns.conf"; then
			HP_DNS_CHANGED=1
			mkdir -p "$DNSMASQ_DIR" &&
				printf 'no-poll\nno-resolv\nserver=127.0.0.1#%s\n' "$port" | dnsmasq_write "$DNSMASQ_DIR/redirect-dns.conf" || return 1
			printf 'conf-dir=%s\n' "$DNSMASQ_DIR" | dnsmasq_write "$DNSMASQ_INCLUDE" || return 1
		fi
	else
		dnsmasq_remove "$HP_DNS_PREVIOUS" "$previous_dir" &&
			dnsmasq_remove "$DNSMASQ_INCLUDE" "$DNSMASQ_DIR" &&
			dnsmasq_remove "$legacy" '' || return 1
	fi
	if [ "$HP_DNS_CHANGED" -eq 1 ] || { [ "$HP_DNS_PREVIOUS" != "$DNSMASQ_INCLUDE" ] && [ "$enabled" -eq 1 ]; } ||
	   { [ "$enabled" -eq 0 ] && [ -n "$HP_DNS_PREVIOUS" ]; }; then
		HP_DNS_CHANGED=1
		dnsmasq_restart "$include" || return 1
	fi
	if [ "$enabled" -eq 0 ]; then
		rm -f "$RUN_DIR/dnsmasq.include"
	elif [ "$HP_DNS_PREVIOUS" != "$DNSMASQ_INCLUDE" ] || [ ! -e "$RUN_DIR/dnsmasq.include" ]; then
		HP_DNS_CHANGED=1
		(umask 077; printf '%s\n' "$DNSMASQ_INCLUDE" > "$RUN_DIR/.reload.pending/dnsmasq.next") &&
			mv -f "$RUN_DIR/.reload.pending/dnsmasq.next" "$RUN_DIR/dnsmasq.include"
	fi
}

# Backup the exact managed paths, not the resolver's directory or neighbors.
# Slots are kept distinct so a path/filename change rolls both sides back.
dnsmasq_snapshot() {
	local backup="$1" operation="$2" previous_dir='' legacy='' status=0
	[ -z "$HP_DNS_PREVIOUS" ] || previous_dir="${HP_DNS_PREVIOUS%/*}/dnsmasq-homeproxy.d"
	[ -z "$DNSMASQ_DIR" ] || legacy="${DNSMASQ_DIR%/*}/dnsmasq-homeproxy.conf"
	[ "$previous_dir" != "$DNSMASQ_DIR" ] || previous_dir=''
	[ "$legacy" != "$DNSMASQ_INCLUDE" ] && [ "$legacy" != "$HP_DNS_PREVIOUS" ] || legacy=''
	local previous="$HP_DNS_PREVIOUS"
	[ "$previous" != "$DNSMASQ_INCLUDE" ] || previous=''
	"$operation" "$backup/dnsmasq.d" "$DNSMASQ_DIR" || status=1
	"$operation" "$backup/dnsmasq.conf" "$DNSMASQ_INCLUDE" || status=1
	"$operation" "$backup/dnsmasq.previous.d" "$previous_dir" || status=1
	"$operation" "$backup/dnsmasq.previous.conf" "$previous" || status=1
	"$operation" "$backup/dnsmasq.legacy.conf" "$legacy" || status=1
	return "$status"
}

backup_dnsmasq_path() {
	[ -n "$2" ] || return 0
	# Record destinations for explicit recovery after an interrupted
	# install; current UCI and even the active marker may already have moved.
	printf '%s	%s\n' "${1##*/}" "$2" >> "${1%/*}/dnsmasq.paths" || return 1
	if [ -e "$2" ] || [ -L "$2" ]; then
		cp -a "$2" "$1"
	fi
}

restore_dnsmasq_path() {
	[ -n "$2" ] || return 0
	homeproxy_restore "$1" "$2"
}

validate_cron_number() {
	case "$1" in
	''|*[!0-9]*) return 1 ;;
	esac

	[ "$1" -ge "$2" ] 2>"/dev/null" && [ "$1" -le "$3" ] 2>"/dev/null"
}

validate_cron_field() {
	local field="$1" minimum="$2" maximum="$3"
	local item base step start end old_ifs

	case "$field" in
	''|,*|*,|*,,*|*[!0-9*/,-]*) return 1 ;;
	esac

	old_ifs="$IFS"
	IFS=','
	set -f
	# shellcheck disable=SC2086
	set -- $field
	set +f
	IFS="$old_ifs"

	for item in "$@"; do
		base="${item%%/*}"
		step=''
		if [ "$base" != "$item" ]; then
			step="${item#*/}"
			[ "${step#*/}" = "$step" ] || return 1
			validate_cron_number "$step" 1 "$((maximum - minimum + 1))" || return 1
		fi

		if [ "$base" = '*' ]; then
			continue
		fi

		start="${base%%-*}"
		if [ "$start" != "$base" ]; then
			end="${base#*-}"
			[ -n "$start" ] && [ -n "$end" ] && [ "${end#*-}" = "$end" ] || return 1
			validate_cron_number "$start" "$minimum" "$maximum" || return 1
			validate_cron_number "$end" "$minimum" "$maximum" || return 1
			[ "$start" -le "$end" ] || return 1
		else
			validate_cron_number "$base" "$minimum" "$maximum" || return 1
		fi
	done
}

validate_cron() {
	local expression="$1"

	case "$expression" in
	""|*[!0-9*/,\ -]*) return 1 ;;
	esac

	set -f
	# Split the expression into exactly five cron fields.
	# shellcheck disable=SC2086
	set -- $expression
	set +f
	[ "$#" -eq 5 ] || return 1

	validate_cron_field "$1" 0 59 &&
		validate_cron_field "$2" 0 23 &&
		validate_cron_field "$3" 1 31 &&
		validate_cron_field "$4" 1 12 &&
		validate_cron_field "$5" 0 6
}

notify_cron() {
	# Restarting crond from its own job can terminate the entire update process.
	printf '%s\n' 'root' >> "${CRON_FILE%/*}/cron.update"
}

configure_subscription_cron() {
	local enabled="$1" schedule="$2"
	local tmp changed=0

	mkdir -p "${CRON_FILE%/*}" "${CRON_LOCK%/*}" || return 1
	lock "$CRON_LOCK" || return 1
	tmp="$(mktemp "${CRON_FILE%/*}/.homeproxy-cron.XXXXXX")" || {
		lock -u "$CRON_LOCK"
		return 1
	}

	if [ -f "$CRON_FILE" ]; then
		sed "/[[:space:]]${CRON_TAG}[[:space:]]*$/d" "$CRON_FILE" > "$tmp" || {
			rm -f "$tmp"
			lock -u "$CRON_LOCK"
			return 1
		}
	fi

	if [ "$enabled" -eq 1 ]; then
		if validate_cron "$schedule"; then
			printf '%s %s %s\n' "$schedule" "$HP_DIR/scripts/update_crond.sh" "$CRON_TAG" >> "$tmp"
		else
			log "Error: invalid client subscription update schedule."
		fi
	fi

	chmod 600 "$tmp" || {
		rm -f "$tmp"
		lock -u "$CRON_LOCK"
		return 1
	}
	if [ -f "$CRON_FILE" ] && cmp -s "$tmp" "$CRON_FILE"; then
		chmod 600 "$CRON_FILE" || {
			rm -f "$tmp"
			lock -u "$CRON_LOCK"
			return 1
		}
		rm -f "$tmp"
	else
		mv -f "$tmp" "$CRON_FILE" || {
			rm -f "$tmp"
			lock -u "$CRON_LOCK"
			return 1
		}
		changed=1
	fi
	lock -u "$CRON_LOCK" || return 1

	[ "$changed" -eq 0 ] || notify_cron
}

sync_subscription_cron() {
	local client_ready="$1"
	local auto_update auto_update_time enabled=0

	config_get_bool auto_update "subscription" "auto_update" "0"
	config_get auto_update_time "subscription" "auto_update_time" "0 */6 * * *"
	if [ "$client_ready" -eq 1 ] && [ "$auto_update" -eq 1 ]; then
		enabled=1
	fi

	configure_subscription_cron "$enabled" "$auto_update_time"
}

_homeproxy_start_service() {
	local outbound_node server_enabled
	config_load "$CONF"
	config_get outbound_node "config" "main_node" "nil"
	config_get_bool server_enabled "server" "enabled" "0"
	# Stopping must not depend on startup-only port/core checks or node repair.
	if [ "$outbound_node" != "nil" ] || [ "$server_enabled" -eq 1 ]; then
		if ! /usr/libexec/homeproxy-runtime-init --runtime-prepared; then
			log "Error: failed to initialize runtime ports."
			return 1
		fi
		if ! ucode -S "$HP_DIR/scripts/cleanup_urltest.uc" >>"$LOG_PATH" 2>&1; then
			log "Error: failed to clean unavailable URLTest nodes."
			return 1
		fi
		config_load "$CONF"
	fi

	local routing_mode
	config_get routing_mode "config" "routing_mode" "bypass_mainland_china"

	config_get outbound_node "config" "main_node" "nil"
	config_get_bool server_enabled "server" "enabled" "0"
	local client_ready=0 server_ready=0
	local dashboard_enabled dashboard_ready=0
	config_get_bool dashboard_enabled "config" "dashboard_enabled" "0"
	if [ "$dashboard_enabled" = "1" ]; then
		rm -f "$DASHBOARD_DIR/.etag"
		if [ -s "$DASHBOARD_DIR/index.html" ]; then
			dashboard_ready=1
		elif [ "$outbound_node" != "nil" ]; then
			log "Client dashboard files are unavailable; download the dashboard in Status > Resource Management before opening it."
		fi
	fi

	if [ "$outbound_node" = "nil" ] && [ "$server_enabled" = "0" ]; then
		if [ "${HP_RELOAD:-0}" -eq 1 ]; then
			HP_NETWORK_CHANGED=1
			stop_service
			return $?
		fi
		sync_subscription_cron 0 || log "Error: failed to clear the subscription update schedule."
		return 1
	fi

	rm -f "$RUN_DIR/sing-box-c.json.new" "$RUN_DIR/sing-box-s.json.new"

	# Generate and validate every enabled instance before changing system state.
	if [ "$outbound_node" != "nil" ]; then
		if ! ucode -S "$HP_DIR/scripts/generate_client.uc" 2>>"$LOG_PATH" || \
		   [ ! -s "$RUN_DIR/sing-box-c.json.new" ]; then
			log "Error: failed to generate client configuration."
			rm -f "$RUN_DIR/sing-box-c.json.new"
		elif ! "$PROG" check --config "$RUN_DIR/sing-box-c.json.new" 2>>"$LOG_PATH"; then
			log "Error: wrong client configuration detected."
			rm -f "$RUN_DIR/sing-box-c.json.new"
		else
			client_ready=1
		fi
	fi

	if [ "$server_enabled" = "1" ]; then
		if ! ucode -S "$HP_DIR/scripts/generate_server.uc" 2>>"$LOG_PATH" || \
		   [ ! -s "$RUN_DIR/sing-box-s.json.new" ]; then
			log "Error: failed to generate server configuration."
			rm -f "$RUN_DIR/sing-box-s.json.new"
		elif ! "$PROG" check --config "$RUN_DIR/sing-box-s.json.new" 2>>"$LOG_PATH"; then
			log "Error: wrong server configuration detected."
			rm -f "$RUN_DIR/sing-box-s.json.new"
		else
			server_ready=1
		fi
	fi

	# A reload is all-or-nothing; never replace a running instance with an
	# empty procd definition just because its new configuration is invalid.
	if [ "${HP_RELOAD:-0}" -eq 1 ] && {
		{ [ "$outbound_node" != "nil" ] && [ "$client_ready" -ne 1 ]; } ||
		{ [ "$server_enabled" -eq 1 ] && [ "$server_ready" -ne 1 ]; }
	}; then
		return 1
	fi

	HP_CONFIG_CHANGED=1
	if [ "$client_ready" -eq 1 ]; then
		mv -f "$RUN_DIR/sing-box-c.json.new" "$RUN_DIR/sing-box-c.json" || return 1
	else
		rm -f "$RUN_DIR/sing-box-c.json.new" "$RUN_DIR/sing-box-c.json"
	fi
	if [ "$server_ready" -eq 1 ]; then
		mv -f "$RUN_DIR/sing-box-s.json.new" "$RUN_DIR/sing-box-s.json" || return 1
	else
		rm -f "$RUN_DIR/sing-box-s.json.new" "$RUN_DIR/sing-box-s.json"
	fi
	if [ "$client_ready" -ne 1 ] && [ "$server_ready" -ne 1 ]; then
		sync_subscription_cron 0 || log "Error: failed to clear the subscription update schedule."
		return 1
	fi

	case "$client_ready:$routing_mode" in
	"1:bypass_mainland_china")
		# Only the root client uses this database; do not give its path to
		# the server uid. Preserve an ordinary legacy database on upgrade.
		[ ! -L "$CACHE_DIR" ] || return 1
		mkdir -p "$CACHE_DIR" && chown root:root "$CACHE_DIR" && chmod 700 "$CACHE_DIR" || return 1
		ucode -e '
			import { prepareFiles } from "/etc/homeproxy/scripts/runtime-files.uc";
			prepareFiles(ARGV[0], ["cache.db"], "cache.db", 0600);
		' "$CACHE_DIR" || return 1
		;;
	esac

	# Prepare firewall before sing-box inserts native TUN auto-redirect rules.
	local firewall_ready=1
	HP_NETWORK_CHANGED=1
	if ! HOMEPROXY_SERVER_READY="$server_ready" \
		ucode "$HP_DIR/scripts/firewall_pre.uc" 2>>"$LOG_PATH"; then
		log "Error: failed to prepare firewall includes."
		[ "${HP_RELOAD:-0}" -ne 1 ] || return 1
		clear_firewall
		firewall_ready=0
		client_ready=0
		rm -f "$RUN_DIR/sing-box-c.json"
	fi
	if [ "$firewall_ready" -eq 1 ] && ! fw4 reload >"/dev/null" 2>&1; then
		log "Error: failed to apply client firewall rules."
		[ "${HP_RELOAD:-0}" -ne 1 ] || return 1
		clear_firewall
		firewall_ready=0
		client_ready=0
		rm -f "$RUN_DIR/sing-box-c.json"
	fi
	local dns_port
	config_get dns_port "infra" "dns_port" "5333"
	if ! apply_dnsmasq "$client_ready" "$dns_port"; then
		log "Error: failed to apply client DNSMasq rules (no usable default conf-dir or startup unconfirmed)."
		return 1
	fi

	sync_subscription_cron "$client_ready" ||
		log "Error: failed to update the subscription update schedule."

	if [ "$client_ready" -eq 1 ]; then
		# sing-box (client)
		procd_open_instance "sing-box-c"

		procd_set_param command "$PROG"
		procd_append_param command run --config "$RUN_DIR/sing-box-c.json"
		procd_set_param file "$RUN_DIR/sing-box-c.json"
		# Directory replacement invalidates sing-box watchers and old jail mounts.
		# Let procd compare resource contents and restart the client if changed.
		[ "$routing_mode" != "bypass_mainland_china" ] ||
			procd_append_param file "$HP_DIR/resources/geoip_cn.srs" "$HP_DIR/resources/geosite_cn.srs"
		# Dashboard updates replace the directory even when JSON is unchanged.
		[ "$dashboard_ready" -ne 1 ] ||
			procd_append_param file "$DASHBOARD_DIR/dashboard.ver"

		# QUIC-GO GSO is broken on kernel 6.6 currently
		uname -r | grep -Eq "^6\.6" && procd_set_param env "QUIC_GO_DISABLE_GSO"="true"
		# The client always creates a TUN inbound with auto_route and
		# auto_redirect, so it cannot run inside the ujail setup used for the
		# server instance below: the jail would need /dev/net/tun plus the
		# netlink access sing-box uses to install its nftables redirect rules.
		# The client is therefore started outside a jail by design.

		procd_set_param limits core="unlimited"
		procd_set_param limits nofile="1000000 1000000"
		procd_set_param stderr 1
		procd_set_param respawn

		procd_close_instance
	fi

	if [ "$client_ready" -eq 0 ] && [ "$server_ready" -eq 1 ] && [ "$firewall_ready" -eq 0 ]; then
		# A client-only setup failure may have cleared shared firewall includes.
		if HOMEPROXY_SERVER_READY=1 ucode "$HP_DIR/scripts/firewall_pre.uc" 2>>"$LOG_PATH" && \
		   fw4 reload >"/dev/null" 2>&1; then
			firewall_ready=1
		else
			log "Error: failed to restore server firewall rules; continuing with the server instance."
			clear_firewall
		fi
	fi

	[ "$client_ready" -eq 1 ] || [ "$server_ready" -eq 1 ] || return 1

	if [ "$server_ready" -eq 1 ]; then
		# Explicit server access, without transferring the runtime parent or
		# unrelated client credentials/recovery material to the service uid.
		touch "$RUN_DIR/sing-box-s.log" || return 1
		chown sing-box:sing-box "$RUN_DIR/sing-box-s.log" "$RUN_DIR/sing-box-s.json" || return 1
		chmod 600 "$RUN_DIR/sing-box-s.json" || return 1
		# sing-box (server)
		procd_open_instance "sing-box-s"

		procd_set_param command "$PROG"
		procd_append_param command run --config "$RUN_DIR/sing-box-s.json"
		procd_set_param file "$RUN_DIR/sing-box-s.json"

		# QUIC-GO GSO is broken on kernel 6.6 currently
		uname -r | grep -Eq "^6\.6" && procd_set_param env "QUIC_GO_DISABLE_GSO"="true"

		if [ -x "/sbin/ujail" ]; then
			procd_add_jail "sing-box-s" log procfs
			procd_add_jail_mount "$RUN_DIR/sing-box-s.json"
			procd_add_jail_mount_rw "$RUN_DIR/sing-box-s.log"
			procd_add_jail_mount_rw "$HP_DIR/certs/"
			procd_add_jail_mount "/etc/acme/"
			procd_add_jail_mount "/etc/ssl/"
			procd_add_jail_mount "/etc/localtime"
			procd_add_jail_mount "/etc/TZ"
			procd_set_param capabilities "/etc/capabilities/homeproxy.json"
			procd_set_param no_new_privs 1
			procd_set_param user sing-box
			procd_set_param group sing-box
		fi

		procd_set_param limits core="unlimited"
		procd_set_param limits nofile="1000000 1000000"
		procd_set_param stderr 1
		procd_set_param respawn

		procd_close_instance
	fi

	# log-cleaner
	procd_open_instance "log-cleaner"
	procd_set_param command "$HP_DIR/scripts/clean_log.sh"
	procd_set_param respawn
	procd_close_instance

	[ "$client_ready" -ne 1 ] || touch "$RUN_DIR/sing-box-c.log" || return 1
	if [ "$server_ready" -eq 1 ]; then
		mkdir -p "$HP_DIR/certs"
		chown -R sing-box:sing-box "$HP_DIR/certs"
		chmod 750 "$HP_DIR/certs"
	fi

	local sing_box_version
	sing_box_version="$(sing-box version -n)"
	if [ "$client_ready" -eq 1 ]; then
		log "sing-box $sing_box_version client started."
	elif [ "$outbound_node" != "nil" ]; then
		log "sing-box $sing_box_version client failed to start."
	fi
	if [ "$server_ready" -eq 1 ]; then
		log "sing-box $sing_box_version server started."
	elif [ "$server_enabled" = "1" ]; then
		log "sing-box $sing_box_version server failed to start."
	fi
}

stop_service() {
	local client_was_running=0 server_was_running=0 status=0

	# stop/restart holds the same native procd lock; preserve unresolved recovery.
	# The all-disabled setup calls stop_service inside an active transaction.
	if [ "${HP_TRANSACTION:-0}" -ne 1 ]; then
		homeproxy_prepare_runtime || return 1
		homeproxy_reload_cleanup || return 1
		local DNSMASQ_DIR DNSMASQ_INCLUDE DNSMASQ_SECTION DNSMASQ_SPEC HP_DNS_PREVIOUS HP_DNS_CHANGED=0
		dnsmasq_discover
		dnsmasq_previous || return 1
	fi
	[ ! -s "$RUN_DIR/sing-box-c.json" ] || client_was_running=1
	[ ! -s "$RUN_DIR/sing-box-s.json" ] || server_was_running=1

	config_load "$CONF"
	sync_subscription_cron 0 || log "Error: failed to clear the subscription update schedule."
	clear_firewall || status=1

	# Remove DNS hijack
	apply_dnsmasq 0 || status=1

	rm -f "$RUN_DIR/sing-box-c.json" "$RUN_DIR/sing-box-c.json.new" \
		"$RUN_DIR/sing-box-s.json" "$RUN_DIR/sing-box-s.json.new"

	# A transactional disable must retain log inodes until procd accepts it.
	if [ "${HP_TRANSACTION:-0}" -eq 1 ]; then
		HP_CLIENT_STOPPED="$client_was_running"
		HP_SERVER_STOPPED="$server_was_running"
		return "$status"
	fi
	if [ "$client_was_running" -eq 1 ]; then
		rm -f "$RUN_DIR/sing-box-c.log"
		log "sing-box client stopped."
	fi
	if [ "$server_was_running" -eq 1 ]; then
		rm -f "$RUN_DIR/sing-box-s.log"
		log "sing-box server stopped."
	fi
	return "$status"
}

# Upstream wrappers finish with JSON cleanup/namespace restoration, masking
# ubus failures. Capture the actual transport status without replacing procd's
# JSON construction; the subshell keeps this adapter local to this submission.
homeproxy_close_service() (
	HP_PROCD_STATUS=1
	ubus() {
		command ubus "$@"
		HP_PROCD_STATUS=$?
		return "$HP_PROCD_STATUS"
	}
	procd_close_service
	return "$HP_PROCD_STATUS"
)

# Never copy into a surviving directory or consume the only recovery copy.
homeproxy_restore() {
	local source="$1" target="$2"
	rm -rf "$target" || return 1
	[ ! -e "$target" ] && [ ! -L "$target" ] || return 1
	[ -e "$source" ] || [ -L "$source" ] || return 0
	cp -a "$source" "$target"
}

# rc.common/procd already serializes start, reload and stop on the service lock.
# Keep one owned generation and its phase outside the backup: partial rm must
# not erase the permission to retry cleanup. Unmarked old generations are never
# discarded, and an interrupted install requires explicit runtime recovery.
homeproxy_reload_cleanup() {
	local backup="$RUN_DIR/.reload.pending" state="$RUN_DIR/reload.state" file phase
	for file in "$RUN_DIR"/.reload.*; do
		[ -e "$file" ] || [ -L "$file" ] || continue
		[ "$file" = "$backup" ] || {
			log "Error: unmarked runtime recovery backup retained at $file."
			return 1
		}
	done
	if [ ! -e "$state" ] && [ ! -L "$state" ]; then
		[ ! -e "$backup" ] && [ ! -L "$backup" ] && return 0
	else
		if [ -f "$state" ] && [ ! -L "$state" ]; then
			for phase in preparing clean; do
				if printf '%s' "$phase" | cmp -s - "$state"; then
					[ ! -L "$backup" ] || break
					rm -rf "$backup" || return 1
					[ ! -e "$backup" ] && [ ! -L "$backup" ] || return 1
					rm -f "$state" || return 1
					[ ! -e "$state" ] && [ ! -L "$state" ]
					return $?
				fi
			done
		fi
	fi
	log "Error: unresolved runtime recovery backup retained at $backup."
	return 1
}

homeproxy_reload_phase() {
	local state="$RUN_DIR/reload.state"
	[ -f "$state" ] && [ ! -L "$state" ] || return 1
	printf '%s' "$1" > "$state"
}

homeproxy_transaction() {
	local service_open="${1:-0}" HP_TRANSACTION=1 HP_CLIENT_STOPPED=0 HP_SERVER_STOPPED=0
	local backup="$RUN_DIR/.reload.pending" file status=0 HP_CONFIG_CHANGED=0 HP_NETWORK_CHANGED=0
	local HP_DNS_CHANGED=0 HP_DNS_PREVIOUS DNSMASQ_DIR DNSMASQ_INCLUDE DNSMASQ_SECTION DNSMASQ_SPEC
	homeproxy_prepare_runtime || return 1
	[ "$service_open" -eq 1 ] || log "Reloading service..."
	# Configuration contains credentials; also tighten files from older installs.
	for file in sing-box-c.json sing-box-s.json; do
		if [ -e "$RUN_DIR/$file" ] || [ -L "$RUN_DIR/$file" ]; then
			[ -f "$RUN_DIR/$file" ] && [ ! -L "$RUN_DIR/$file" ] &&
				chmod 600 "$RUN_DIR/$file" || return 1
			# The server's retained config must remain readable after rollback.
			[ "$file" != sing-box-c.json ] || chown root:root "$RUN_DIR/$file" || return 1
		fi
	done
	if [ -d "$backup" ] && [ ! -L "$backup" ]; then
		chown root:root "$backup" && chmod 700 "$backup" || return 1
	fi
	homeproxy_reload_cleanup || return 1
	dnsmasq_discover
	dnsmasq_previous || return 1
	(umask 077; set -C; printf preparing > "$RUN_DIR/reload.state") || return 1
	mkdir -m 700 "$backup" || return 1
	for file in sing-box-c.json sing-box-s.json fw4_input.nft; do
		if [ -e "$RUN_DIR/$file" ]; then
			cp -p "$RUN_DIR/$file" "$backup/$file" || status=1
		fi
	done
	dnsmasq_snapshot "$backup" backup_dnsmasq_path || status=1
	backup_dnsmasq_path "$backup/dnsmasq.include" "$RUN_DIR/dnsmasq.include" || status=1
	if [ "$status" -ne 0 ]; then
		homeproxy_reload_cleanup || log "Error: failed to remove unused runtime backup at $backup."
		return 1
	fi

	homeproxy_reload_phase installing || return 1
	[ "$service_open" -eq 1 ] || procd_open_service "$CONF" "$initscript"
	if _homeproxy_start_service && homeproxy_close_service; then
		if [ "$HP_CLIENT_STOPPED" -eq 1 ]; then
			rm -f "$RUN_DIR/sing-box-c.log"
			log "sing-box client stopped."
		fi
		if [ "$HP_SERVER_STOPPED" -eq 1 ]; then
			rm -f "$RUN_DIR/sing-box-s.log"
			log "sing-box server stopped."
		fi
		homeproxy_reload_phase clean || return 1
		homeproxy_reload_cleanup || {
			log "Error: service configured but runtime backup cleanup failed at $backup."
			return 1
		}
		return 0
	fi

	if [ "$HP_CONFIG_CHANGED" -eq 1 ] || [ "$HP_NETWORK_CHANGED" -eq 1 ]; then
		for file in sing-box-c.json sing-box-s.json fw4_input.nft; do
			homeproxy_restore "$backup/$file" "$RUN_DIR/$file" || status=1
		done
	fi
	rm -f "$RUN_DIR/sing-box-c.json.new" "$RUN_DIR/sing-box-s.json.new"
	if [ "$HP_NETWORK_CHANGED" -eq 1 ]; then
		fw4 reload >"/dev/null" 2>&1 || status=1
	fi
	if [ "$HP_DNS_CHANGED" -eq 1 ]; then
		if ! dnsmasq_snapshot "$backup" restore_dnsmasq_path; then
			status=1
		# Restored bytes in a retired conf-dir don't restore the running rules.
		# Do not restart again with a config that cannot read the old include.
		elif [ -n "$HP_DNS_PREVIOUS" ] && [ "$HP_DNS_PREVIOUS" != "$DNSMASQ_INCLUDE" ]; then
			status=1
		elif ! dnsmasq_restart "$HP_DNS_PREVIOUS"; then
			status=1
		fi
		homeproxy_restore "$backup/dnsmasq.include" "$RUN_DIR/dnsmasq.include" || status=1
	fi
	if [ "$status" -ne 0 ]; then
		log "Error: service setup failed and runtime restoration was incomplete; backup retained at $backup."
	else
		log "Error: service setup failed; previous runtime configuration retained."
		homeproxy_reload_phase clean && homeproxy_reload_cleanup ||
			log "Error: failed to remove restored runtime backup at $backup."
	fi
	return 1
}

start_service() {
	local HP_RELOAD=1
	homeproxy_transaction 1
	HP_START_STATUS=$?
	# rc_procd already opened this definition. It must not submit a second,
	# empty definition after the transaction has closed (or rejected) it.
	procd_close_service() { :; }
	return "$HP_START_STATUS"
}

service_started() {
	return "${HP_START_STATUS:-0}"
}

reload_service() {
	local HP_RELOAD=1
	homeproxy_transaction
}

service_triggers() {
	local outbound_node server_enabled
	config_load "$CONF"
	config_get outbound_node "config" "main_node" "nil"
	config_get_bool server_enabled "server" "enabled" "0"

	# Keep Apply able to enable the service, but do not wake a disabled service
	# on interface events. The disabling reload still completes runtime cleanup.
	procd_add_reload_trigger "$CONF"
	if [ "$outbound_node" != "nil" ] || [ "$server_enabled" -eq 1 ]; then
		# System time servers affect the client's bootstrap path; reload when edited.
		if [ "$outbound_node" != "nil" ]; then
			procd_add_config_trigger "config.change" "system" /etc/init.d/$CONF reload
		fi
		# The next uplink may not exist yet; observe all interfaces while enabled.
		procd_add_raw_trigger "interface.*" 1000 /etc/init.d/$CONF reload
	fi
}
