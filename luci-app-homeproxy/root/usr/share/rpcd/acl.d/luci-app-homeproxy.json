{
	"luci-app-homeproxy": {
		"description": "Grant access to homeproxy configuration",
		"read": {
			"ubus": {
				"service": [ "list" ],
				"luci-rpc": [ "getHostHints" ],
				"luci.homeproxy": [
					"acllist_read", "connection_check", "current_node_get",
					"node_latency_test", "resources_get", "log_read",
					"singbox_generator", "singbox_get_features"
				]
			},
			"uci": [ "homeproxy" ]
		},
		"write": {
			"file": {
				"/etc/homeproxy/scripts/update_subscriptions.sh": [ "exec" ],
				"/tmp/homeproxy_certificate-*": [ "write" ]
			},
			"ubus": {
				"luci.homeproxy": [
					"acllist_write", "certificate_write", "log_clean", "resources_update"
				]
			},
			"uci": [ "homeproxy" ]
		}
	}
}
