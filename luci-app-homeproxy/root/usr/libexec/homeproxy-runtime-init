#!/bin/sh

# Absolute-path libuci loads are non-delta packages: neither the default
# /tmp/.uci drafts nor /var/run/uci overrides are read or committed.
umask 077
uci_get() {
	ucode -l uci -e '
		const c = uci.cursor();
		if (!c || c.load("/etc/config/homeproxy") !== true) exit(1);
		const value = c.get("homeproxy", ARGV[0], ARGV[1]);
		if (type(value) == "string") print(value);
	' "$@"
}

dashboard_port="$(uci_get config dashboard_port)" || exit 1
dashboard_port_initialized="$(uci_get config dashboard_port_initialized)" || exit 1
clash_api_port="$(uci_get infra clash_api_port)" || exit 1
clash_api_port_initialized="$(uci_get infra clash_api_port_initialized)" || exit 1
main_node="$(uci_get config main_node)" || exit 1
dashboard_enabled="$(uci_get config dashboard_enabled)" || exit 1
tailscale_enabled="$(uci_get tailscale enabled)" || exit 1

mkdir -p /var/run/homeproxy

log() {
	printf '%s [DAEMON] %s\n' "$(date "+%Y-%m-%d %H:%M:%S")" "$*" >> /var/run/homeproxy/homeproxy.log
}

random_port() {
	/usr/libexec/homeproxy-random-port "$@"
}

valid_port() {
	case "$1" in
	''|*[!0-9]*) return 1 ;;
	esac
	[ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

initialize_port() {
	local port="$1" default_port="$2" initialized="$3" reserved="$4"

	if ! valid_port "$port" || { [ "$port" = "$default_port" ] && [ "$initialized" != '1' ]; }; then
		port="$(random_port "$reserved")" || return 1
	fi
	valid_port "$port" || return 1
	printf '%s\n' "$port"
}

sing_box_version="$(/usr/bin/sing-box version -n 2>/dev/null)"
sing_box_major="${sing_box_version%%.*}"
sing_box_minor="${sing_box_version#*.}"
sing_box_minor="${sing_box_minor%%.*}"
case "$sing_box_major:$sing_box_minor" in
*[!0-9:]*|:*)
	log "HomeProxy requires sing-box 1.14 or newer."
	exit 1
	;;
esac
if [ "$sing_box_major" -lt 1 ] || \
   { [ "$sing_box_major" -eq 1 ] && [ "$sing_box_minor" -lt 14 ]; }; then
	log "HomeProxy requires sing-box 1.14 or newer; found $sing_box_version."
	exit 1
fi

clash_api_port="$(initialize_port "$clash_api_port" 9090 "$clash_api_port_initialized" "$dashboard_port")" || exit 1
dashboard_port="$(initialize_port "$dashboard_port" 9095 "$dashboard_port_initialized" "$clash_api_port")" || exit 1

if [ "$main_node" = 'urltest' ] && { [ "$dashboard_enabled" = '1' ] || [ "$tailscale_enabled" = '1' ]; } && \
   [ "$clash_api_port" = "$dashboard_port" ]; then
	dashboard_port="$(random_port "$clash_api_port")" || exit 1
	valid_port "$dashboard_port" || exit 1
fi

# The caller's existing procd lock serializes service initialization. Reload
# persistent state after port selection, then change only these four fields in
# one in-memory transaction; no set/save can leave a partial shared delta.
ucode -l uci -e '
	function persistent() {
		const c = uci.cursor();
		if (!c || c.load("/etc/config/homeproxy") !== true) exit(1);
		return c;
	}
	const c = persistent();
	const fields = [
		["infra", "clash_api_port", ARGV[0]],
		["config", "dashboard_port", ARGV[1]],
		["infra", "clash_api_port_initialized", "1"],
		["config", "dashboard_port_initialized", "1"]
	];
	let changed = false;
	for (let field in fields) {
		if (c.get("homeproxy", field[0], field[1]) === field[2]) continue;
		if (c.set("homeproxy", field[0], field[1], field[2]) !== true) exit(1);
		changed = true;
	}
	if (changed) {
		if (c.commit("homeproxy") !== true) exit(1);
		const actual = persistent();
		for (let field in fields)
			if (actual.get("homeproxy", field[0], field[1]) !== field[2]) exit(1);
	}
' "$clash_api_port" "$dashboard_port" || exit 1
exit 0
